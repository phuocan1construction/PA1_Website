---
// Bảng thống kê truy cập — chỉ admin (mật khẩu kiểm tra phía Google Apps Script).
// Mở bằng nút 🔒 cuối trang Liên hệ hoặc link /lien-he#admin
---
<section class="as-zone">
  <div class="wrap">
    <button type="button" class="as-lock" id="as-lock" aria-label="Quản trị" title="Quản trị">🔒</button>

    <div class="as-panel" id="as-panel" hidden>
      <div class="as-head">
        <h2>Thống kê truy cập</h2>
        <button type="button" class="as-x" id="as-close" aria-label="Đóng">✕</button>
      </div>

      <form class="as-login" id="as-login" autocomplete="off">
        <label for="as-key">Mật khẩu admin</label>
        <div class="as-row">
          <input type="password" id="as-key" required autocomplete="current-password">
          <button type="submit" class="form-submit">Xem thống kê</button>
        </div>
        <p class="as-msg" id="as-msg"></p>
      </form>

      <div id="as-body" hidden>
        <div class="as-bar">
          <div class="as-filters" id="as-filters">
            <button type="button" data-days="1">Hôm nay</button>
            <button type="button" data-days="7" class="on">7 ngày</button>
            <button type="button" data-days="30">30 ngày</button>
            <button type="button" data-days="0">Tất cả</button>
          </div>
          <div class="as-tools">
            <label class="as-check"><input type="checkbox" id="as-notrack"> Không ghi lượt truy cập của máy này</label>
            <button type="button" id="as-reload">↻ Tải lại</button>
            <button type="button" id="as-logout">Đăng xuất</button>
          </div>
        </div>

        <div class="as-kpis" id="as-kpis"></div>

        <h3>Theo trang</h3>
        <div class="as-tw"><table class="as-t" id="as-pages">
          <thead><tr>
            <th data-k="path">Trang</th><th data-k="views" class="n">Số lượt</th><th data-k="sec" class="n">Tổng thời gian</th>
            <th data-k="avg" class="n">TB / lượt</th><th data-k="users" class="n">User</th>
          </tr></thead><tbody></tbody>
        </table></div>

        <h3>Theo user</h3>
        <div class="as-tw"><table class="as-t" id="as-users">
          <thead><tr>
            <th data-k="vid">User</th><th data-k="name">Khách</th><th data-k="device">Thiết bị</th><th data-k="ref">Nguồn</th>
            <th data-k="views" class="n">Số lượt</th><th data-k="sessions" class="n">Phiên</th><th data-k="sec" class="n">Tổng thời gian</th>
            <th data-k="last">Lần cuối</th><th>Trang đã xem</th>
          </tr></thead><tbody></tbody>
        </table></div>
        <p class="as-note" id="as-note"></p>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .as-zone { padding: 0 0 var(--sp-3); }
  .as-lock { background: none; font-size: .9rem; opacity: .25; padding: 4px 8px; display: block; margin-left: auto; }
  .as-lock:hover { opacity: .7; }
  .as-panel { scroll-margin-top: 90px; margin-top: var(--sp-3); border: 1px solid var(--border); border-top: 4px solid var(--gold); border-radius: 4px; padding: var(--sp-4); background: var(--white); }
  .as-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--sp-3); }
  .as-x { background: none; font-size: 1.2rem; color: var(--text-light); }
  .as-login label { font-weight: 700; display: block; margin-bottom: var(--sp-1); }
  .as-row { display: flex; gap: var(--sp-2); flex-wrap: wrap; }
  .as-row input { flex: 1 1 220px; padding: .8em 1em; border: 1px solid var(--border); border-radius: 3px; }
  .as-msg { color: #b42318; min-height: 1.4em; margin: var(--sp-1) 0 0; font-size: .92rem; }
  .as-bar { display: flex; justify-content: space-between; gap: var(--sp-2); flex-wrap: wrap; margin-bottom: var(--sp-3); }
  .as-filters, .as-tools { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
  .as-filters button, .as-tools button { background: var(--light); padding: .45em .9em; border-radius: 3px; font-size: .9rem; color: var(--text); }
  .as-filters button.on { background: var(--dark); color: var(--gold); }
  .as-check { font-size: .88rem; color: var(--text-light); display: flex; gap: 6px; align-items: center; margin-right: 6px; }
  .as-kpis { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--sp-2); margin-bottom: var(--sp-4); }
  .as-kpi { background: var(--light); border-radius: 4px; padding: var(--sp-2); }
  .as-kpi b { display: block; font-family: var(--font-display); font-size: 1.7rem; color: var(--dark); font-variant-numeric: tabular-nums; }
  .as-kpi span { font-size: .85rem; color: var(--text-light); }
  .as-panel h3 { margin: 0 0 var(--sp-2); }
  .as-tw { overflow-x: auto; margin-bottom: var(--sp-4); }
  .as-t { width: 100%; border-collapse: collapse; font-size: .92rem; }
  .as-t th { text-align: left; background: var(--dark); color: var(--white); padding: .6em .7em; white-space: nowrap; cursor: pointer; user-select: none; font-weight: 600; }
  .as-t th.sorted::after { content: ' ▾'; color: var(--gold); }
  .as-t th.sorted.asc::after { content: ' ▴'; }
  .as-t td { padding: .55em .7em; border-bottom: 1px solid var(--light-dark); vertical-align: top; }
  .as-t tr:hover td { background: #fffaf0; }
  .as-t .n { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .as-t .sub { color: var(--text-light); font-size: .82rem; }
  .as-t .lead { color: var(--dark); font-weight: 700; }
  .as-t .lead a { color: var(--gold-dark); }
  .as-t td:first-child { min-width: 170px; }
  .as-paths { min-width: 200px; max-width: 340px; color: var(--text-light); font-size: .84rem; }
  .as-note { font-size: .82rem; color: var(--text-light); }
  @media (max-width: 760px) {
    .as-panel { padding: var(--sp-2); }
    .as-kpis { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script>
  const $ = (id: string) => document.getElementById(id)!;
  const KEY = 'pa1_admin_key';
  const ss = { get: (k: string) => { try { return sessionStorage.getItem(k); } catch { return null; } },
               set: (k: string, v: string) => { try { sessionStorage.setItem(k, v); } catch {} },
               del: (k: string) => { try { sessionStorage.removeItem(k); } catch {} } };
  const ls = { get: (k: string) => { try { return localStorage.getItem(k); } catch { return null; } },
               set: (k: string, v: string | null) => { try { v === null ? localStorage.removeItem(k) : localStorage.setItem(k, v); } catch {} } };

  let days = 7, data: any = null;
  const sortState: Record<string, { k: string; asc: boolean }> = { 'as-pages': { k: 'views', asc: false }, 'as-users': { k: 'last', asc: false } };

  const esc = (s: any) => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  const num = (n: number) => n.toLocaleString('vi-VN');
  const dur = (s: number) => {
    s = Math.round(s || 0);
    const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), x = s % 60;
    return h ? `${h}h ${String(m).padStart(2, '0')}m` : m ? `${m}m ${String(x).padStart(2, '0')}s` : `${x}s`;
  };
  const when = (t: number) => new Date(t).toLocaleString('vi-VN', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit' });

  function endpoint(): string { return (window as any).PA1_TRACK_ENDPOINT || ''; }

  function open() {
    $('as-panel').hidden = false;
    if (ss.get(KEY)) load(); else ($('as-key') as HTMLInputElement).focus();
    $('as-panel').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  function close() { $('as-panel').hidden = true; if (location.hash === '#admin') history.replaceState(null, '', location.pathname); }

  async function load(key?: string) {
    const msg = $('as-msg');
    if (!endpoint()) { msg.textContent = 'Chưa cấu hình link Google Apps Script trong /pa1-track.js.'; return; }
    key = key || ss.get(KEY) || '';
    msg.style.color = ''; msg.textContent = 'Đang tải…';
    try {
      const r = await fetch(endpoint(), { method: 'POST', headers: { 'Content-Type': 'text/plain;charset=utf-8' }, body: JSON.stringify({ t: 'stats', key, days }) });
      const j = await r.json();
      if (!j.ok) {
        ss.del(KEY); $('as-body').hidden = true; $('as-login').hidden = false;
        msg.textContent = j.error === 'locked' ? 'Sai mật khẩu quá nhiều lần — thử lại sau 15 phút.'
                        : j.error === 'setup' ? 'Chưa đặt mật khẩu admin trong Apps Script (ADMIN_PASSWORD).'
                        : 'Sai mật khẩu.';
        return;
      }
      ss.set(KEY, key);
      if (ls.get('pa1_notrack_set') !== '1') { ls.set('pa1_notrack', '1'); ls.set('pa1_notrack_set', '1'); }
      ($('as-notrack') as HTMLInputElement).checked = ls.get('pa1_notrack') === '1';
      msg.textContent = ''; data = j;
      $('as-login').hidden = true; $('as-body').hidden = false;
      render();
    } catch (e) {
      msg.textContent = 'Không kết nối được máy chủ thống kê. Kiểm tra mạng hoặc link Web App.';
    }
  }

  function sortRows(id: string, rows: any[]) {
    const { k, asc } = sortState[id];
    const val = (r: any) => k === 'avg' ? (r.views ? r.sec / r.views : 0) : k === 'name' ? (r.lead ? r.lead.name : '~') : r[k];
    return rows.slice().sort((a, b) => { const x = val(a), y = val(b); const c = typeof x === 'number' ? x - y : String(x).localeCompare(String(y), 'vi'); return asc ? c : -c; });
  }

  function render() {
    const t = data.totals;
    $('as-kpis').innerHTML = [
      [num(t.views), 'Lượt xem trang'], [num(t.users), 'User'], [dur(t.sec), 'Tổng thời gian xem'], [num(t.leads), 'User đã để lại liên hệ']
    ].map(([v, l]) => `<div class="as-kpi"><b>${v}</b><span>${l}</span></div>`).join('');

    $('as-pages').querySelector('tbody')!.innerHTML = sortRows('as-pages', data.pages).map((p: any) => `
      <tr><td><a href="${esc(p.path)}" target="_blank">${esc(p.path)}</a><div class="sub">${esc(p.title)}</div></td>
      <td class="n">${num(p.views)}</td><td class="n">${dur(p.sec)}</td><td class="n">${dur(p.views ? p.sec / p.views : 0)}</td><td class="n">${num(p.users)}</td></tr>`).join('')
      || '<tr><td colspan="5">Chưa có dữ liệu trong khoảng này.</td></tr>';

    $('as-users').querySelector('tbody')!.innerHTML = sortRows('as-users', data.users).map((u: any) => `
      <tr><td><b>${esc(u.vid)}</b></td>
      <td>${u.lead ? `<span class="lead">${esc(u.lead.name)}</span><div class="sub"><a href="tel:${esc(u.lead.phone)}">${esc(u.lead.phone)}</a>${u.lead.service ? ' · ' + esc(u.lead.service) : ''}</div>` : '<span class="sub">Ẩn danh</span>'}</td>
      <td>${esc(u.device)}<div class="sub">${esc(u.browser)}</div></td><td>${esc(u.ref)}</td>
      <td class="n">${num(u.views)}</td><td class="n">${num(u.sessions)}</td><td class="n">${dur(u.sec)}</td>
      <td>${when(u.last)}<div class="sub">từ ${when(u.first)}</div></td>
      <td class="as-paths">${esc(u.paths.join(', '))}</td></tr>`).join('')
      || '<tr><td colspan="9">Chưa có dữ liệu trong khoảng này.</td></tr>';

    for (const id of ['as-pages', 'as-users']) {
      $(id).querySelectorAll('th').forEach(th => {
        th.classList.toggle('sorted', th.dataset.k === sortState[id].k);
        th.classList.toggle('asc', th.dataset.k === sortState[id].k && sortState[id].asc);
      });
    }
    $('as-note').textContent = `Cập nhật lúc ${new Date(data.generated).toLocaleString('vi-VN')}. Thời gian xem chỉ tính khi tab đang mở và khách có thao tác trong 5 phút gần nhất. "User" là mã khách ẩn danh theo trình duyệt; có tên/SĐT khi khách gửi form liên hệ.`;
  }

  // ---- sự kiện
  $('as-lock').addEventListener('click', open);
  $('as-close').addEventListener('click', close);
  $('as-login').addEventListener('submit', e => { e.preventDefault(); load(($('as-key') as HTMLInputElement).value.trim()); });
  $('as-reload').addEventListener('click', () => load());
  $('as-logout').addEventListener('click', () => { ss.del(KEY); data = null; $('as-body').hidden = true; $('as-login').hidden = false; ($('as-key') as HTMLInputElement).value = ''; close(); });
  $('as-notrack').addEventListener('change', e => { ls.set('pa1_notrack', (e.target as HTMLInputElement).checked ? '1' : null); ls.set('pa1_notrack_set', '1'); });
  $('as-filters').addEventListener('click', e => {
    const b = (e.target as HTMLElement).closest('button'); if (!b) return;
    days = Number(b.dataset.days);
    $('as-filters').querySelectorAll('button').forEach(x => x.classList.toggle('on', x === b));
    load();
  });
  for (const id of ['as-pages', 'as-users']) {
    $(id).querySelector('thead')!.addEventListener('click', e => {
      const th = (e.target as HTMLElement).closest('th'); if (!th || !th.dataset.k || !data) return;
      const s = sortState[id]; s.asc = s.k === th.dataset.k ? !s.asc : false; s.k = th.dataset.k; render();
    });
  }
  if (location.hash === '#admin' || ss.get(KEY)) { if (location.hash === '#admin') open(); }
  window.addEventListener('hashchange', () => { if (location.hash === '#admin') open(); });
</script>
