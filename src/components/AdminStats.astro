---
// Bảng thống kê truy cập — chỉ admin (mật khẩu kiểm tra phía Google Apps Script).
// Mở bằng nút 🔒 cuối trang Liên hệ hoặc link /lien-he#admin
---
<section class="as-zone">
  <div class="wrap">
    <button type="button" class="as-lock" id="as-lock" aria-label="Quản trị" title="Quản trị">🔒</button>

    <div class="as-panel" id="as-panel" hidden>
      <div class="as-head">
        <h2>Thống kê truy cập</h2>
        <button type="button" class="as-x" id="as-close" aria-label="Đóng">✕</button>
      </div>

      <form class="as-login" id="as-login" autocomplete="off">
        <label for="as-key">Mật khẩu admin</label>
        <div class="as-row">
          <input type="password" id="as-key" required autocomplete="current-password">
          <button type="submit" class="form-submit">Xem thống kê</button>
        </div>
        <p class="as-msg" id="as-msg"></p>
      </form>

      <div id="as-body" hidden>
        <div class="as-bar">
          <div class="as-filters" id="as-filters">
            <button type="button" data-days="1">Hôm nay</button>
            <button type="button" data-days="7" class="on">7 ngày</button>
            <button type="button" data-days="30">30 ngày</button>
            <button type="button" data-days="0">Tất cả</button>
          </div>
          <div class="as-tools">
            <label class="as-check"><input type="checkbox" id="as-notrack"> Không ghi lượt truy cập của máy này</label>
            <label class="as-check"><input type="checkbox" id="as-auto" checked> Tự cập nhật 10s</label>
            <span class="as-stamp" id="as-stamp"></span>
            <button type="button" id="as-reload">↻ Tải lại</button>
            <button type="button" id="as-logout">Đăng xuất</button>
          </div>
        </div>

        <div class="as-live" id="as-live"></div>

        <div class="as-charts as-time">
          <div class="as-card">
            <h3>30 phút gần nhất</h3>
            <p class="as-insight" id="as-min-note"></p>
            <div class="as-hourwrap" id="as-min"></div>
          </div>
          <div class="as-card">
            <h3 id="as-trend-h">Lượt truy cập theo thời gian</h3>
            <p class="as-insight" id="as-trend-note"></p>
            <div class="as-hourwrap" id="as-trend"></div>
          </div>
        </div>

        <div class="as-kpis" id="as-kpis"></div>

        <div class="as-charts">
          <div class="as-card">
            <h3>Lượt xem theo khung giờ</h3>
            <p class="as-insight" id="as-peak"></p>
            <div class="as-hourwrap" id="as-hours"></div>
          </div>
          <div class="as-card">
            <h3>Trang được quan tâm nhất</h3>
            <p class="as-insight" id="as-toppage"></p>
            <div id="as-top"></div>
          </div>
        </div>

        <h3>Theo trang</h3>
        <div class="as-tw"><table class="as-t" id="as-pages">
          <thead><tr>
            <th data-k="path">Trang</th><th data-k="views" class="n">Số lượt</th><th data-k="sec" class="n">Tổng thời gian</th>
            <th data-k="avg" class="n">TB / lượt</th><th data-k="users" class="n">User</th>
          </tr></thead><tbody></tbody>
        </table></div>

        <h3>Theo user</h3>
        <div class="as-tw"><table class="as-t" id="as-users">
          <thead><tr>
            <th data-k="vid">User</th><th data-k="name">Khách</th><th data-k="device">Thiết bị</th><th data-k="ref">Nguồn</th>
            <th data-k="views" class="n">Số lượt</th><th data-k="sessions" class="n">Phiên</th><th data-k="sec" class="n">Tổng thời gian</th>
            <th data-k="last">Lần cuối</th><th>Trang đã xem</th>
          </tr></thead><tbody></tbody>
        </table></div>
        <p class="as-note" id="as-note"></p>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .as-zone { padding: 0 0 var(--sp-3); }
  .as-lock { background: none; font-size: .9rem; opacity: .25; padding: 4px 8px; display: block; margin-left: auto; }
  .as-lock:hover { opacity: .7; }
  .as-panel { scroll-margin-top: 90px; margin-top: var(--sp-3); border: 1px solid var(--border); border-top: 4px solid var(--gold); border-radius: 4px; padding: var(--sp-4); background: var(--white); }
  .as-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--sp-3); }
  .as-x { background: none; font-size: 1.2rem; color: var(--text-light); }
  .as-login label { font-weight: 700; display: block; margin-bottom: var(--sp-1); }
  .as-row { display: flex; gap: var(--sp-2); flex-wrap: wrap; }
  .as-row input { flex: 1 1 220px; padding: .8em 1em; border: 1px solid var(--border); border-radius: 3px; }
  .as-msg { color: #b42318; min-height: 1.4em; margin: var(--sp-1) 0 0; font-size: .92rem; }
  .as-bar { display: flex; justify-content: space-between; gap: var(--sp-2); flex-wrap: wrap; margin-bottom: var(--sp-3); }
  .as-filters, .as-tools { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
  .as-filters button, .as-tools button { background: var(--light); padding: .45em .9em; border-radius: 3px; font-size: .9rem; color: var(--text); }
  .as-filters button.on { background: var(--dark); color: var(--gold); }
  .as-check { font-size: .88rem; color: var(--text-light); display: flex; gap: 6px; align-items: center; margin-right: 6px; }
  .as-kpis { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--sp-2); margin-bottom: var(--sp-4); }
  .as-kpi { background: var(--light); border-radius: 4px; padding: var(--sp-2); }
  .as-kpi b { display: block; font-family: var(--font-display); font-size: 1.7rem; color: var(--dark); font-variant-numeric: tabular-nums; }
  .as-kpi span { font-size: .85rem; color: var(--text-light); }
  .as-panel h3 { margin: 0 0 var(--sp-2); }
  .as-stamp { font-size: .8rem; color: var(--text-light); font-variant-numeric: tabular-nums; min-width: 5.5em; }
  .as-live { border: 1px solid var(--light-dark); border-left: 4px solid #1f9d55; border-radius: 4px; padding: var(--sp-2); margin-bottom: var(--sp-3); }
  .as-live-h { display: flex; align-items: center; gap: 10px; font-weight: 700; }
  .as-live-h b { font-family: var(--font-display); font-size: 1.6rem; font-variant-numeric: tabular-nums; }
  .as-dot { width: 10px; height: 10px; border-radius: 50%; background: #1f9d55; box-shadow: 0 0 0 0 rgba(31,157,85,.5); animation: as-pulse 1.8s infinite; }
  .as-dot.off { background: #bbb; animation: none; }
  @keyframes as-pulse { 70% { box-shadow: 0 0 0 8px rgba(31,157,85,0); } 100% { box-shadow: 0 0 0 0 rgba(31,157,85,0); } }
  .as-live ul { margin: var(--sp-1) 0 0; display: grid; gap: 4px; }
  .as-live li { display: flex; gap: 10px; flex-wrap: wrap; font-size: .9rem; }
  .as-live li .sub { color: var(--text-light); }
  .as-charts { display: grid; grid-template-columns: 1.3fr 1fr; gap: var(--sp-3); margin-bottom: var(--sp-4); }
  .as-card { border: 1px solid var(--light-dark); border-radius: 4px; padding: var(--sp-2) var(--sp-3) var(--sp-3); min-width: 0; }
  .as-insight { margin: -6px 0 var(--sp-2); font-size: .9rem; color: var(--text-light); }
  .as-insight b { color: var(--dark); }
  .as-hourwrap { position: relative; }
  .as-hourwrap svg { width: 100%; height: auto; display: block; }
  .as-hourwrap .bar { fill: #3d3d3d; }
  .as-hourwrap .bar.peak { fill: var(--gold-dark); }
  .as-hourwrap .hit { fill: transparent; cursor: default; }
  .as-hourwrap .bar.hov { opacity: .7; }
  .as-hourwrap text { font-size: 11px; fill: #777; font-family: var(--font-body); }
  .as-hourwrap .grid { stroke: #ececec; stroke-width: 1; }
  .as-tip { position: absolute; pointer-events: none; background: var(--dark); color: #fff; font-size: .8rem; padding: 6px 9px; border-radius: 4px; white-space: nowrap; transform: translate(-50%, -110%); display: none; }
  .as-tip b { color: var(--gold); }
  .as-time { grid-template-columns: 1fr 1.6fr; }
  .as-hourwrap .line { fill: none; stroke: #3d3d3d; stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
  .as-hourwrap .area { fill: rgba(217,160,32,.14); }
  .as-hourwrap .pt { fill: #3d3d3d; stroke: #fff; stroke-width: 2; }
  .as-hourwrap .pt.last { fill: var(--gold-dark); }
  .as-hourwrap .cross { stroke: #bbb; stroke-width: 1; stroke-dasharray: 3 3; }
  .as-top-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2px 10px; margin-bottom: 10px; font-size: .88rem; }
  .as-top-row .lbl { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .as-top-row .val { color: var(--text-light); font-variant-numeric: tabular-nums; text-align: right; }
  .as-top-row .track { grid-column: 1 / -1; height: 8px; background: var(--light); border-radius: 4px; overflow: hidden; }
  .as-top-row .fill { height: 100%; background: #3d3d3d; border-radius: 0 4px 4px 0; }
  .as-top-row:first-child .fill { background: var(--gold-dark); }
  .as-tw { overflow-x: auto; margin-bottom: var(--sp-4); }
  .as-t { width: 100%; border-collapse: collapse; font-size: .92rem; }
  .as-t th { text-align: left; background: var(--dark); color: var(--white); padding: .6em .7em; white-space: nowrap; cursor: pointer; user-select: none; font-weight: 600; }
  .as-t th.sorted::after { content: ' ▾'; color: var(--gold); }
  .as-t th.sorted.asc::after { content: ' ▴'; }
  .as-t td { padding: .55em .7em; border-bottom: 1px solid var(--light-dark); vertical-align: top; }
  .as-t tr:hover td { background: #fffaf0; }
  .as-t .n { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .as-t .sub { color: var(--text-light); font-size: .82rem; }
  .as-t .lead { color: var(--dark); font-weight: 700; }
  .as-t .lead a { color: var(--gold-dark); }
  .as-t td:first-child { min-width: 170px; }
  .as-paths { min-width: 200px; max-width: 340px; color: var(--text-light); font-size: .84rem; }
  .as-note { font-size: .82rem; color: var(--text-light); }
  @media (max-width: 760px) {
    .as-panel { padding: var(--sp-2); }
    .as-kpis { grid-template-columns: repeat(2, 1fr); }
    .as-charts { grid-template-columns: 1fr; }
  }
</style>

<script>
  const $ = (id: string) => document.getElementById(id)!;
  const KEY = 'pa1_admin_key';
  const ss = { get: (k: string) => { try { return sessionStorage.getItem(k); } catch { return null; } },
               set: (k: string, v: string) => { try { sessionStorage.setItem(k, v); } catch {} },
               del: (k: string) => { try { sessionStorage.removeItem(k); } catch {} } };
  const ls = { get: (k: string) => { try { return localStorage.getItem(k); } catch { return null; } },
               set: (k: string, v: string | null) => { try { v === null ? localStorage.removeItem(k) : localStorage.setItem(k, v); } catch {} } };

  let days = 7, data: any = null;
  const sortState: Record<string, { k: string; asc: boolean }> = { 'as-pages': { k: 'views', asc: false }, 'as-users': { k: 'last', asc: false } };

  const esc = (s: any) => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  const num = (n: number) => n.toLocaleString('vi-VN');
  const dur = (s: number) => {
    s = Math.round(s || 0);
    const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), x = s % 60;
    return h ? `${h}h ${String(m).padStart(2, '0')}m` : m ? `${m}m ${String(x).padStart(2, '0')}s` : `${x}s`;
  };
  const when = (t: number) => new Date(t).toLocaleString('vi-VN', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit' });

  function endpoint(): string { return (window as any).PA1_TRACK_ENDPOINT || ''; }

  function open() {
    $('as-panel').hidden = false;
    if (ss.get(KEY)) load(); else ($('as-key') as HTMLInputElement).focus();
    $('as-panel').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  function close() { $('as-panel').hidden = true; if (location.hash === '#admin') history.replaceState(null, '', location.pathname); }

  let busy = false;
  async function load(key?: string, silent = false) {
    const msg = $('as-msg');
    if (!endpoint()) { msg.textContent = 'Chưa cấu hình link Google Apps Script trong /pa1-track.js.'; return; }
    if (busy) return;
    key = key || ss.get(KEY) || '';
    if (!silent) { msg.style.color = ''; msg.textContent = 'Đang tải…'; $('as-stamp').textContent = 'Đang tải…'; }
    busy = true;
    try {
      const r = await fetch(endpoint(), { method: 'POST', headers: { 'Content-Type': 'text/plain;charset=utf-8' }, body: JSON.stringify({ t: 'stats', key, days }) });
      const j = await r.json();
      if (!j.ok) {
        ss.del(KEY); $('as-body').hidden = true; $('as-login').hidden = false;
        msg.textContent = j.error === 'locked' ? 'Sai mật khẩu quá nhiều lần — thử lại sau 15 phút.'
                        : j.error === 'setup' ? 'Chưa đặt mật khẩu admin trong Apps Script (ADMIN_PASSWORD).'
                        : 'Sai mật khẩu.';
        return;
      }
      ss.set(KEY, key);
      if (ls.get('pa1_notrack_set') !== '1') { ls.set('pa1_notrack', '1'); ls.set('pa1_notrack_set', '1'); }
      ($('as-notrack') as HTMLInputElement).checked = ls.get('pa1_notrack') === '1';
      msg.textContent = ''; data = j;
      $('as-login').hidden = true; $('as-body').hidden = false;
      render();
    } catch (e) {
      if (silent && data) $('as-stamp').textContent = 'Mất kết nối, thử lại…';
      else msg.textContent = 'Không kết nối được máy chủ thống kê. Kiểm tra mạng hoặc link Web App.';
    } finally { busy = false; }
  }

  // ---- Tự cập nhật mỗi 10 giây (chỉ khi bảng đang mở và tab đang hiển thị)
  setInterval(() => {
    const auto = ($('as-auto') as HTMLInputElement).checked;
    if (auto && data && !$('as-panel').hidden && !$('as-body').hidden && document.visibilityState === 'visible') load(undefined, true);
  }, 10000);

  function sortRows(id: string, rows: any[]) {
    const { k, asc } = sortState[id];
    const val = (r: any) => k === 'avg' ? (r.views ? r.sec / r.views : 0) : k === 'name' ? (r.lead ? r.lead.name : '~') : r[k];
    return rows.slice().sort((a, b) => { const x = val(a), y = val(b); const c = typeof x === 'number' ? x - y : String(x).localeCompare(String(y), 'vi'); return asc ? c : -c; });
  }

  function render() {
    const t = data.totals;
    $('as-kpis').innerHTML = [
      [num(t.views), 'Lượt xem trang'], [num(t.users), 'User'], [dur(t.sec), 'Tổng thời gian xem'], [num(t.leads), 'User đã để lại liên hệ']
    ].map(([v, l]) => `<div class="as-kpi"><b>${v}</b><span>${l}</span></div>`).join('');

    renderLive();
    renderMinutes();
    renderTrend();
    renderHours();
    renderTop();
    $('as-stamp').textContent = 'Lúc ' + new Date(data.generated).toLocaleTimeString('vi-VN');

    $('as-pages').querySelector('tbody')!.innerHTML = sortRows('as-pages', data.pages).map((p: any) => `
      <tr><td><a href="${esc(p.path)}" target="_blank">${esc(p.path)}</a><div class="sub">${esc(p.title)}</div></td>
      <td class="n">${num(p.views)}</td><td class="n">${dur(p.sec)}</td><td class="n">${dur(p.views ? p.sec / p.views : 0)}</td><td class="n">${num(p.users)}</td></tr>`).join('')
      || '<tr><td colspan="5">Chưa có dữ liệu trong khoảng này.</td></tr>';

    $('as-users').querySelector('tbody')!.innerHTML = sortRows('as-users', data.users).map((u: any) => `
      <tr><td><b>${esc(u.vid)}</b></td>
      <td>${u.lead ? `<span class="lead">${esc(u.lead.name)}</span><div class="sub"><a href="tel:${esc(u.lead.phone)}">${esc(u.lead.phone)}</a>${u.lead.service ? ' · ' + esc(u.lead.service) : ''}</div>` : '<span class="sub">Ẩn danh</span>'}</td>
      <td>${esc(u.device)}<div class="sub">${esc(u.browser)}</div></td><td>${esc(u.ref)}</td>
      <td class="n">${num(u.views)}</td><td class="n">${num(u.sessions)}</td><td class="n">${dur(u.sec)}</td>
      <td>${when(u.last)}<div class="sub">từ ${when(u.first)}</div></td>
      <td class="as-paths">${esc(u.paths.join(', '))}</td></tr>`).join('')
      || '<tr><td colspan="9">Chưa có dữ liệu trong khoảng này.</td></tr>';

    for (const id of ['as-pages', 'as-users']) {
      $(id).querySelectorAll('th').forEach(th => {
        th.classList.toggle('sorted', th.dataset.k === sortState[id].k);
        th.classList.toggle('asc', th.dataset.k === sortState[id].k && sortState[id].asc);
      });
    }
    $('as-note').textContent = `Cập nhật lúc ${new Date(data.generated).toLocaleString('vi-VN')}. Thời gian xem chỉ tính khi tab đang mở và khách có thao tác trong 5 phút gần nhất. "User" là mã khách ẩn danh theo trình duyệt; có tên/SĐT khi khách gửi form liên hệ.`;
  }

  function who(vid: string) {
    const u = (data.users || []).find((x: any) => x.vid === vid);
    return u && u.lead ? `<b>${esc(u.lead.name)}</b> <span class="sub">${esc(vid)}</span>` : `<b>${esc(vid)}</b>`;
  }
  function renderLive() {
    const live = data.live || [];
    $('as-live').innerHTML = `<div class="as-live-h"><span class="as-dot${live.length ? '' : ' off'}"></span>Đang truy cập: <b>${live.length}</b></div>` +
      (live.length ? `<ul>${live.map((l: any) => `<li>${who(l.vid)} <span>đang xem <a href="${esc(l.path)}" target="_blank">${esc(l.path)}</a></span><span class="sub">${esc(l.device)} · ${esc(l.browser)} · ${l.ago}s trước</span></li>`).join('')}</ul>`
                   : '<div class="sub" style="font-size:.88rem;margin-top:4px;color:var(--text-light)">Không có khách nào trong 45 giây qua.</div>');
  }

  function renderHours() {
    const h: number[] = data.hours || new Array(24).fill(0), hs: number[] = data.hourSec || new Array(24).fill(0);
    const total = h.reduce((a, b) => a + b, 0), max = Math.max(1, ...h);
    const peak = total ? h.indexOf(Math.max(...h)) : -1;
    // khung 3 giờ đông nhất
    let best = 0, bi = 0; for (let i = 0; i < 24; i++) { const v = h[i] + h[(i + 1) % 24] + h[(i + 2) % 24]; if (v > best) { best = v; bi = i; } }
    $('as-peak').innerHTML = total
      ? `Đông nhất: <b>${peak}h–${peak + 1}h</b> (${num(h[peak])} lượt, ${Math.round(h[peak] / total * 100)}%). Khung 3 giờ cao điểm: <b>${bi}h–${(bi + 3) % 24 || 24}h</b> (${Math.round(best / total * 100)}%).`
      : 'Chưa có dữ liệu trong khoảng này.';
    const W = Math.max(280, Math.round($('as-hours').clientWidth || 720)), H = W < 480 ? 170 : 190, L = 30, B = 22, T = 10, cw = (W - L) / 24, bw = Math.max(3, cw - (W < 480 ? 2 : 4)), every = W < 480 ? 6 : 3;
    const nice = (m: number) => { const st = [1, 2, 5, 10, 20, 25, 50, 100, 200, 250, 500, 1000, 2000, 5000]; for (const x of st) if (m / x <= 4) return x; return Math.ceil(m / 4); };
    const step = nice(max), top = Math.max(step, Math.ceil(max / step) * step), y = (v: number) => T + (H - T - B) * (1 - v / top);
    let g = '';
    for (let v = 0; v <= top; v += step) g += `<line class="grid" x1="${L}" x2="${W}" y1="${y(v)}" y2="${y(v)}"/><text x="${L - 6}" y="${y(v) + 4}" text-anchor="end">${v}</text>`;
    let bars = '', hits = '';
    h.forEach((v, i) => {
      const x = L + i * cw + (cw - bw) / 2, yy = y(v), hh = (H - B) - yy, r = Math.min(4, hh / 2, bw / 2);
      const path = v ? `M${x},${H - B} V${yy + r} Q${x},${yy} ${x + r},${yy} H${x + bw - r} Q${x + bw},${yy} ${x + bw},${yy + r} V${H - B} Z` : '';
      hits += `<rect class="hit" data-i="${i}" x="${L + i * cw}" y="${T}" width="${cw}" height="${H - T - B}"/>`;
      if (path) bars += `<path class="bar${i === peak ? ' peak' : ''}" data-b="${i}" d="${path}"/>`;
      if (i % every === 0) bars += `<text x="${x + bw / 2}" y="${H - 6}" text-anchor="middle">${i}h</text>`;
    });
    $('as-hours').innerHTML = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Lượt xem theo giờ trong ngày">${g}${bars}${hits}</svg><div class="as-tip" id="as-tip"></div>`;
    const tip = $('as-tip'), wrap = $('as-hours');
    wrap.querySelectorAll('.hit').forEach(el => {
      el.addEventListener('mouseenter', () => {
        const i = Number((el as HTMLElement).dataset.i), r = (el as SVGGraphicsElement).getBoundingClientRect(), wr = wrap.getBoundingClientRect();
        tip.innerHTML = `<b>${i}:00–${i}:59</b><br>${num(h[i])} lượt xem · TB ${dur(h[i] ? hs[i] / h[i] : 0)}/lượt`;
        tip.style.left = (r.left - wr.left + r.width / 2) + 'px';
        tip.style.top = Math.max(30, y(h[i]) / H * wr.height) + 'px';
        tip.style.display = 'block';
        wrap.querySelector(`[data-b="${i}"]`)?.classList.add('hov');
      });
      el.addEventListener('mouseleave', () => { tip.style.display = 'none'; wrap.querySelectorAll('.bar.hov').forEach(b => b.classList.remove('hov')); });
    });
  }

  // ---- khung trục dùng chung
  function axes(W: number, H: number, L: number, T: number, B: number, max: number) {
    const nice = (m: number) => { for (const x of [1, 2, 5, 10, 20, 25, 50, 100, 200, 250, 500, 1000, 2000, 5000]) if (m / x <= 4) return x; return Math.ceil(m / 4); };
    const step = nice(Math.max(1, max)), top = Math.max(step, Math.ceil(max / step) * step);
    const y = (v: number) => T + (H - T - B) * (1 - v / top);
    let g = '';
    for (let v = 0; v <= top; v += step) g += `<line class="grid" x1="${L}" x2="${W}" y1="${y(v)}" y2="${y(v)}"/><text x="${L - 6}" y="${y(v) + 4}" text-anchor="end">${v}</text>`;
    return { y, g };
  }
  function tipAt(wrap: HTMLElement, tip: HTMLElement, xPx: number, yPx: number, html: string) {
    tip.innerHTML = html; tip.style.display = 'block';
    const wr = wrap.clientWidth, half = tip.offsetWidth / 2;
    tip.style.left = Math.min(wr - half, Math.max(half, xPx)) + 'px'; tip.style.top = Math.max(34, yPx) + 'px';
  }

  // ---- 30 phút gần nhất: cột theo từng phút
  function renderMinutes() {
    const m: number[] = data.minutes || new Array(30).fill(0), wrap = $('as-min');
    const total = m.reduce((a, b) => a + b, 0), last5 = m.slice(-5).reduce((a, b) => a + b, 0);
    $('as-min-note').innerHTML = `<b>${num(total)}</b> lượt xem trong 30 phút · <b>${num(last5)}</b> trong 5 phút gần nhất`;
    const W = Math.max(260, Math.round(wrap.clientWidth || 360)), H = 170, L = 26, B = 22, T = 10, cw = (W - L) / 30, bw = Math.max(2, cw - 2);
    const { y, g } = axes(W, H, L, T, B, Math.max(...m));
    let bars = '', hits = '';
    m.forEach((v, i) => {
      const x = L + i * cw + (cw - bw) / 2, yy = y(v), hh = (H - B) - yy, r = Math.min(3, hh / 2, bw / 2);
      if (v) bars += `<path class="bar${i === 29 ? ' peak' : ''}" data-b="${i}" d="M${x},${H - B} V${yy + r} Q${x},${yy} ${x + r},${yy} H${x + bw - r} Q${x + bw},${yy} ${x + bw},${yy + r} V${H - B} Z"/>`;
      hits += `<rect class="hit" data-i="${i}" x="${L + i * cw}" y="${T}" width="${cw}" height="${H - T - B}"/>`;
    });
    const lab = [[0, '-30p'], [15, '-15p'], [29, 'bây giờ']].map(([i, t]) => `<text x="${L + (i as number) * cw + cw / 2}" y="${H - 6}" text-anchor="${i === 29 ? 'end' : 'middle'}">${t}</text>`).join('');
    wrap.innerHTML = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Lượt xem 30 phút gần nhất">${g}${bars}${lab}${hits}</svg><div class="as-tip"></div>`;
    const tip = wrap.querySelector('.as-tip') as HTMLElement, base = data.nowMs || data.generated;
    wrap.querySelectorAll('.hit').forEach(el => {
      el.addEventListener('mouseenter', () => {
        const i = Number((el as HTMLElement).dataset.i), t = new Date(base - (29 - i) * 60000);
        const r = (el as SVGGraphicsElement).getBoundingClientRect(), wr = wrap.getBoundingClientRect();
        tipAt(wrap, tip, r.left - wr.left + r.width / 2, y(m[i]) / H * wr.height, `<b>${t.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' })}</b><br>${num(m[i])} lượt xem`);
        wrap.querySelector(`[data-b="${i}"]`)?.classList.add('hov');
      });
      el.addEventListener('mouseleave', () => { tip.style.display = 'none'; wrap.querySelectorAll('.bar.hov').forEach(b => b.classList.remove('hov')); });
    });
  }

  // ---- Xu hướng: đường theo giờ (Hôm nay) hoặc theo ngày
  function renderTrend() {
    const wrap = $('as-trend');
    let labels: string[] = [], vals: number[] = [], tips: string[] = [];
    if (data.days === 1) {
      const nowH = new Date(data.nowMs || data.generated).getHours();
      const h: number[] = (data.todayH || []).slice(0, nowH + 1);
      h.forEach((v, i) => { labels.push(i + 'h'); vals.push(v); tips.push(`${i}:00–${i}:59`); });
      $('as-trend-h').textContent = 'Hôm nay theo giờ';
    } else {
      const keys = Object.keys(data.daily || {}).sort();
      const end = new Date(data.today + 'T00:00:00+07:00').getTime();
      const n = data.days > 0 ? data.days : Math.max(1, keys.length ? Math.round((end - new Date(keys[0] + 'T00:00:00+07:00').getTime()) / 86400000) + 1 : 1);
      for (let i = n - 1; i >= 0; i--) {
        const d = new Date(end - i * 86400000 + 7 * 3600000), k = d.toISOString().slice(0, 10);
        labels.push(k.slice(8, 10) + '/' + k.slice(5, 7)); vals.push(data.daily[k] || 0);
        tips.push(['CN', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7'][d.getUTCDay()] + ', ' + k.slice(8, 10) + '/' + k.slice(5, 7) + '/' + k.slice(0, 4));
      }
      $('as-trend-h').textContent = 'Lượt truy cập theo ngày';
    }
    const total = vals.reduce((a, b) => a + b, 0), mx = Math.max(0, ...vals), mi = vals.indexOf(mx);
    $('as-trend-note').innerHTML = total ? `Tổng <b>${num(total)}</b> lượt · cao nhất <b>${tips[mi]}</b> (${num(mx)} lượt)` : 'Chưa có dữ liệu trong khoảng này.';
    const W = Math.max(280, Math.round(wrap.clientWidth || 560)), H = 170, L = 30, B = 22, T = 12, R = 10;
    const { y, g } = axes(W, H, L, T, B, mx);
    const n = vals.length, x = (i: number) => n === 1 ? (L + W - R) / 2 : L + (W - L - R) * i / (n - 1);
    const pts = vals.map((v, i) => [x(i), y(v)]);
    const line = pts.map((p, i) => (i ? 'L' : 'M') + p[0].toFixed(1) + ',' + p[1].toFixed(1)).join(' ');
    const area = n ? `${line} L${x(n - 1)},${H - B} L${x(0)},${H - B} Z` : '';
    const every = Math.max(1, Math.ceil(n / Math.max(3, Math.floor((W - L) / 56))));
    let lab = '';
    labels.forEach((t, i) => { if ((i % every === 0 && (n - 1 - i >= every * 0.75 || i === 0)) || i === n - 1) lab += `<text x="${x(i)}" y="${H - 6}" text-anchor="${i === 0 ? 'start' : i === n - 1 ? 'end' : 'middle'}">${t}</text>`; });
    const dots = n <= 14 ? pts.map((p, i) => `<circle class="pt${i === n - 1 ? ' last' : ''}" cx="${p[0]}" cy="${p[1]}" r="${i === n - 1 ? 4.5 : 3}"/>`).join('') : `<circle class="pt last" cx="${pts[n - 1][0]}" cy="${pts[n - 1][1]}" r="4.5"/>`;
    wrap.innerHTML = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Lượt truy cập theo thời gian">${g}<path class="area" d="${area}"/><path class="line" d="${line}"/>${dots}${lab}<line class="cross" id="as-cross" y1="${T}" y2="${H - B}" style="display:none"/><rect class="hit" x="${L}" y="${T}" width="${W - L}" height="${H - T - B}"/></svg><div class="as-tip"></div>`;
    const tip = wrap.querySelector('.as-tip') as HTMLElement, svg = wrap.querySelector('svg')!, cross = wrap.querySelector('#as-cross') as SVGLineElement, hit = wrap.querySelector('.hit')!;
    hit.addEventListener('mousemove', (e: any) => {
      const r = svg.getBoundingClientRect(), sx = (e.clientX - r.left) / r.width * W;
      const i = Math.max(0, Math.min(n - 1, Math.round(n === 1 ? 0 : (sx - L) / (W - L - R) * (n - 1))));
      cross.setAttribute('x1', String(x(i))); cross.setAttribute('x2', String(x(i))); cross.style.display = '';
      tipAt(wrap, tip, x(i) / W * r.width, y(vals[i]) / H * r.height, `<b>${tips[i]}</b><br>${num(vals[i])} lượt xem`);
    });
    hit.addEventListener('mouseleave', () => { tip.style.display = 'none'; cross.style.display = 'none'; });
  }

  function renderTop() {
    const pages = (data.pages || []).slice().sort((a: any, b: any) => b.views - a.views).slice(0, 8);
    const max = Math.max(1, ...pages.map((p: any) => p.views));
    const longest = (data.pages || []).filter((p: any) => p.views).sort((a: any, b: any) => b.sec / b.views - a.sec / a.views)[0];
    $('as-toppage').innerHTML = pages.length
      ? `Nhiều lượt nhất: <b>${esc(pages[0].path)}</b>` + (longest ? ` · Xem lâu nhất: <b>${esc(longest.path)}</b> (TB ${dur(longest.sec / longest.views)})` : '')
      : 'Chưa có dữ liệu trong khoảng này.';
    $('as-top').innerHTML = pages.map((p: any) => `
      <div class="as-top-row" title="${esc(p.title)}"><span class="lbl">${esc(p.path)}</span><span class="val">${num(p.views)} lượt · ${dur(p.sec)}</span>
      <div class="track"><div class="fill" style="width:${Math.max(2, p.views / max * 100)}%"></div></div></div>`).join('');
  }

  let rz: any; window.addEventListener('resize', () => { clearTimeout(rz); rz = setTimeout(() => { if (data && !$('as-body').hidden) { renderMinutes(); renderTrend(); renderHours(); } }, 150); });

  // ---- sự kiện
  $('as-lock').addEventListener('click', open);
  $('as-close').addEventListener('click', close);
  $('as-login').addEventListener('submit', e => { e.preventDefault(); load(($('as-key') as HTMLInputElement).value.trim()); });
  $('as-reload').addEventListener('click', () => load());
  $('as-logout').addEventListener('click', () => { ss.del(KEY); data = null; $('as-body').hidden = true; $('as-login').hidden = false; ($('as-key') as HTMLInputElement).value = ''; close(); });
  $('as-notrack').addEventListener('change', e => { ls.set('pa1_notrack', (e.target as HTMLInputElement).checked ? '1' : null); ls.set('pa1_notrack_set', '1'); });
  $('as-filters').addEventListener('click', e => {
    const b = (e.target as HTMLElement).closest('button'); if (!b) return;
    days = Number(b.dataset.days);
    $('as-filters').querySelectorAll('button').forEach(x => x.classList.toggle('on', x === b));
    load();
  });
  for (const id of ['as-pages', 'as-users']) {
    $(id).querySelector('thead')!.addEventListener('click', e => {
      const th = (e.target as HTMLElement).closest('th'); if (!th || !th.dataset.k || !data) return;
      const s = sortState[id]; s.asc = s.k === th.dataset.k ? !s.asc : false; s.k = th.dataset.k; render();
    });
  }
  if (location.hash === '#admin' || ss.get(KEY)) { if (location.hash === '#admin') open(); }
  window.addEventListener('hashchange', () => { if (location.hash === '#admin') open(); });
</script>
