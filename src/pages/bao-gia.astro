---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import { asset } from '../utils/paths';

const basePath = '/assets/images/quotation';

const designQuote = [
  { src: '2_Design/Design_01.jpg', label: 'Báo giá thiết kế (1)' },
  { src: '2_Design/Design_02.jpg', label: 'Báo giá thiết kế (2)' },
];

const buildQuote = [
  { src: '3_Build/01_Structural/Quotation_Structural.jpg', label: 'Thi công phần thô' },
  { src: '3_Build/02_Full/Quotation_Full.jpg', label: 'Thi công trọn gói' },
  { src: '3_Build/03_Finish/Quotation_Finish.jpg', label: 'Thi công hoàn thiện' },
];
---

<BaseLayout
  title="Báo giá — PA1 Construction"
  description="Báo giá vật tư xây dựng, vật liệu hoàn thiện và cách tính diện tích xây dựng quy đổi. PA1 Construction minh bạch từ báo giá."
  activePage="bao-gia"
>

  <section class="page-header">
    <div class="wrap">
      <h1>Có khi nào!!!</h1>
      <p>Bạn mua một món tưởng "hời",<br>nhưng khi nhận nó, chỉ muốn vứt nó đi cho xong!!!</p>
    </div>
  </section>

  <!-- Cách tính diện tích -->
  <section>
    <div class="wrap">
      <div class="section-header">
        <h2>Cách tính diện tích xây dựng</h2>
        <p>Hiểu đúng cách quy đổi diện tích để biết chính xác chi phí xây nhà.</p>
      </div>
      <div class="quote-grid" style="max-width: 800px; margin: 0 auto;">
        <div class="quote-card">
          <img src={asset(`${basePath}/1_General/001_CachTinhDienTichXayDung.png`)} alt="Cách tính diện tích xây dựng quy đổi" loading="lazy">
        </div>
      </div>
      <div style="text-align:center; margin-top: var(--sp-4);">
        <a href="/khai-toan" class="btn btn-primary">Tính diện tích &amp; chi phí nhà bạn →</a>
      </div>
    </div>
  </section>

  <!-- Báo giá thiết kế -->
  <section style="background: var(--light);">
    <div class="wrap">
      <div class="quote-category">
        <div class="section-header">
          <h2>Báo giá Thiết kế</h2>
        </div>
        <div class="quote-grid">
          {designQuote.map(item => (
            <div class="quote-card">
              <img src={asset(`${basePath}/${item.src}`)} alt={item.label} loading="lazy">
              <div class="quote-label">{item.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Báo giá thi công -->
  <section>
    <div class="wrap">
      <div class="quote-category">
        <div class="section-header">
          <h2>Báo giá Thi công</h2>
          <p>Phần thô, trọn gói, hoàn thiện — chọn gói phù hợp nhu cầu.</p>
        </div>
        <div class="quote-grid">
          {buildQuote.map(item => (
            <div class="quote-card">
              <img src={asset(`${basePath}/${item.src}`)} alt={item.label} loading="lazy">
              <div class="quote-label">{item.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    title="Cần báo giá chi tiết cho công trình của bạn?"
    description="Liên hệ PA1 để được khảo sát thực tế & báo giá chính xác trong 24 giờ."
    buttonText="Liên hệ báo giá →"
  />

</BaseLayout>
