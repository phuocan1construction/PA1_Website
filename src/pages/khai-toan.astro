  function floorName(i) {
    var f = S.floors[i];
    if (f.kind === 'lung') { var nl = 0, tl = 0; S.floors.forEach(function (x, j) { if (x.kind === 'lung') { tl++; if (j <= i) nl++; } }); return tl > 1 ? 'Tầng lửng ' + nl : 'Tầng lửng'; }
    var n = 0; for (var j = 0; j <= i; j++) if (S.floors[j].kind !== 'lung') n++; return 'Lầu ' + n;
  }
  function $(sel, root) { return (root || document).querySelector(sel); }
  function $$(sel, root) { return Array.prototype.slice.call((root || document).querySelectorAll(sel)); }
  function save() { try { localStorage.setItem(KEY, JSON.stringify(S)); } catch (e) {} }

  /* ====== FORM RENDER ====== */
  function row(path, label, sub, extra) {
