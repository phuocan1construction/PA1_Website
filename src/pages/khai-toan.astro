      '</div><div class="kt-f"><label for="kt-pkg">' + g.label + '</label>' + sel('pkg.' + S.goi, g.list, function (o) { return o.name + ' · ' + fmt(o.min, 2) + '–' + fmt(o.max, 2) + ' tr/m²'; }).replace('<select', '<select id="kt-pkg"') + '</div>' +
