  }
  function sel(path, list, fn, aria) { return '<select data-path="' + path + '"' + (aria ? ' aria-label="' + aria + '"' : '') + '>' + opts(list, get(path), fn) + '</select>'; }

  function renderForm() {
    var h = '';
    // 1
    h += '<section class="kt-card" id="kt-s1"><div class="kt-card-h"><h2>Lô đất &amp; đường vào</h2><span class="kt-stepno">BƯỚC 1/4</span></div>' +
