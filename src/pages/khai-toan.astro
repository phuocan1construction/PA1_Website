  }
  var S;
  try { S = JSON.parse(localStorage.getItem(KEY) || 'null'); } catch (e) { S = null; }
  if (!S || S.v !== 1 || !S.tret || !S.floors) S = sample();
  if (location.hash === '#chi-phi') S.tab = 'cp';

  /* ====== HELPERS ====== */
  function num(v) { if (v == null || v === '') return 0; var n = parseFloat(String(v).replace(/\s/g, '').replace(',', '.')); return isFinite(n) && n > 0 ? n : 0; }
