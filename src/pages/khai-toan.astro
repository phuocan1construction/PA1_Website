  /* ====== CALC ====== */
  function calc() {
    var R = [];
    var lot = num(S.w) * num(S.l);
    var lg = find(LOGIOI, S.lg);
    var tretA = area(S.tret.san);
    var mongA = S.mongA === '' ? tretA : num(S.mongA);
    var m = find(MONG, S.mong);
    R.push({ g: 'Móng', label: m.name, a: mongA, k: m.k });
    if (S.ham.on) { var hm = find(HAM, S.ham.depth); R.push({ g: 'Tầng hầm', label: hm.name, a: area(S.ham.it), k: hm.k, path: 'ham.it', note: hm.id === 'lt1' ? 'Bán hầm, tính như sàn trệt' : '' }); }
    R.push({ g: 'Tầng trệt', fl: 'tret', label: 'Sàn trong nhà', a: tretA, k: 100, path: 'tret.san', real: 1 });
    var st = find(SAN, S.tret.sanType);
    R.push({ g: 'Tầng trệt', fl: 'tret', label: 'Sân · ' + st.name, a: area(S.tret.sanTrc), k: st.k, path: 'tret.sanTrc', real: 1 });
    S.floors.forEach(function (f, i) {
      var g = floorName(i), p = 'floors.' + i, ta = area(f.tt), warn = '';
      if (f.bc.dxr && num(f.bc.r) > 0) {
        if (lg.max === 0) warn = 'Lộ giới dưới 7m không được vươn ban công';
        else if (num(f.bc.r) > lg.max + 1e-9) warn = 'Vượt mức ' + fmt(lg.max) + 'm cho phép';
      }
      R.push({ g: g, fl: i, label: 'Sàn trong nhà', a: area(f.san), k: 100, path: p + '.san', real: 1 });
      R.push({ g: g, fl: i, label: 'Ô thông tầng', a: ta, k: ta > 8 ? 50 : 100, path: p + '.tt', real: 1 });
      R.push({ g: g, fl: i, label: 'Ban công', a: area(f.bc), k: 50, path: p + '.bc', warn: warn, real: 1 });
    });
    if (S.thuong.on) {
      R.push({ g: 'Tầng thượng', fl: 'thuong', label: 'Có mái', a: area(S.thuong.coMai), k: 100, path: 'thuong.coMai', real: 1 });
      R.push({ g: 'Tầng thượng', fl: 'thuong', label: 'Không mái', a: area(S.thuong.khongMai), k: 50, path: 'thuong.khongMai', real: 1 });
    }
    S.mai.forEach(function (x, i) { var mt = find(MAI, x.t); R.push({ g: 'Mái', label: mt.name, a: area(x.it), k: mt.k, path: 'mai.' + i + '.it' }); });
    var total = 0, real = 0;
    R.forEach(function (r) { r.q = r.a * r.k / 100; total += r.q; if (r.real) real += r.a; });
    return { R: R, total: total, real: real, lot: lot, lg: lg, tretA: tretA, mongA: mongA, mongK: m.k };
  }

  function out(name, html, attr) { $$('[data-out="' + name + '"]').forEach(function (el) { if (attr) el.setAttribute(attr, html); else if (el.tagName === 'INPUT') el.value = html; else el.innerHTML = html; }); }

  function update() {
    var c = calc(), R = c.R;
    // per-row
    R.forEach(function (r) {
      if (!r.path) return;
      var k = $('[data-k="' + r.path + '"]'), q = $('[data-q="' + r.path + '"]'), w = $('[data-w="' + r.path + '"]');
      if (k) k.textContent = r.k + '%';
      if (q) q.textContent = fmt(r.q);
      if (w) { w.hidden = !r.warn; w.textContent = r.warn || ''; }
    });
    // hầm row when off
    if (!S.ham.on) { var hk = $('[data-k="ham.it"]'); if (hk) hk.textContent = find(HAM, S.ham.depth).k + '%'; var hq = $('[data-q="ham.it"]'); if (hq) hq.textContent = '–'; }
    if (!S.thuong.on) { ['thuong.coMai', 'thuong.khongMai'].forEach(function (p, j) { var a = $('[data-k="' + p + '"]'); if (a) a.textContent = (j ? 50 : 100) + '%'; var b = $('[data-q="' + p + '"]'); if (b) b.textContent = '–'; }); }
    // floor chips
    var fl = {};
    R.forEach(function (r) { if (r.fl != null) fl[r.fl] = (fl[r.fl] || 0) + r.q; });
    Object.keys(fl).forEach(function (k) { out('fl-' + k, fmt(fl[k]) + ' m²'); });
    if (!S.thuong.on) out('fl-thuong', 'Không có');
    // step 1/2 outputs
    out('lot', c.lot ? fmt(c.lot) : '');
    var lgTxt = c.lg.max ? 'Ban công vươn ra tối đa ' + fmt(c.lg.max) + 'm' : 'Không được vươn ban công, chỉ làm lô-gia thụt vào';
    out('lgChip', lgTxt);
    var dv = find(DUONG, S.dv);
    out('dvChip', dv.max ? 'Phát sinh +' + dv.min + '–' + dv.max + '% đơn giá' : 'Tính theo đơn giá gốc');
    $$('[data-out="dvChip"]').forEach(function (el) { el.classList.toggle('warn', !!dv.max); });
    out('muaHint', S.mua === 'mua' ? 'Mùa mưa: phát sinh che chắn, hút nước móng, bảo dưỡng bê tông phức tạp hơn.' : S.mua === 'kho' ? 'Mùa khô: thi công thuận lợi, tiến độ nhanh; giá vật liệu thường cao hơn.' : '');
    var mp = $('#kt-mongA'); if (mp) mp.placeholder = fmt(c.tretA);
    out('mongQ', fmt(c.mongA * c.mongK / 100));
    // result
    out('total', fmt(c.total)); out('total2', fmt(c.total));
    out('floorReal', fmt(c.real, 0) + ' m²');
    var nl = S.floors.filter(function (f) { return f.kind !== 'lung'; }).length, nlung = S.floors.length - nl;
    out('scale', (S.ham.on ? 'Hầm + ' : '') + 'Trệt' + (nlung ? ' + lửng' : '') + (nl ? ' + ' + nl + ' lầu' : '') + (S.thuong.on ? ' + thượng' : ''));
    out('density', c.lot && c.tretA ? fmt(c.tretA / c.lot * 100, 0) + '%' : '–');
    var body = '', lastG = '';
    R.forEach(function (r) {
      if (!r.a) return;
      if (r.g !== lastG && r.g !== 'Móng') body += '<tr class="g"><td colspan="4">' + esc(r.g) + '</td></tr>';
      lastG = r.g;
      body += '<tr><td>' + esc(r.label) + (r.note ? '<small>' + esc(r.note) + '</small>' : '') + (r.warn ? '<small style="color:var(--kt-warn)">' + esc(r.warn) + '</small>' : '') + '</td><td class="r">' + fmt(r.a) + '</td><td class="r">' + r.k + '%</td><td class="r">' + fmt(r.q) + '</td></tr>';
    });
    out('rows', body || '<tr><td colspan="4" class="kt-empty">Nhập diện tích ở các bước bên trái để xem chi tiết.</td></tr>');
    // factors
    var fct = '';
    if (dv.max) fct += '<div><span>' + esc(dv.name) + '</span><span class="kt-chip warn">+' + dv.min + '–' + dv.max + '%</span></div>';
    if (S.mua === 'mua') fct += '<div><span>Khởi công mùa mưa</span><span class="kt-chip">Có phát sinh</span></div>';
    R.forEach(function (r) { if (r.warn) fct += '<div><span>Ban công ' + esc(r.g) + '</span><span class="kt-chip warn">Cần điều chỉnh</span></div>'; });
    out('factors', fct);
    var fc = $('[data-out="factorsCard"]'); if (fc) fc.hidden = !fct;
    // cost
    var g = PRICES[S.goi], p = find(g.list, S.pkg[S.goi]);
    var lo = c.total * p.min * (1 + dv.min / 100), hi = c.total * p.max * (1 + dv.max / 100);
    var rangeTxt = c.total ? (moneyUnit(lo) === moneyUnit(hi) ? money(lo) + ' – ' + money(hi) + ' ' + moneyUnit(hi) : money(lo) + ' ' + moneyUnit(lo) + ' – ' + money(hi) + ' ' + moneyUnit(hi)) : '–';
    out('costArea', fmt(c.total));
    out('range', rangeTxt);
    out('rangeNote', g.name + ' · ' + p.name);
    out('costRows',
      '<tr><td>Diện tích quy đổi</td><td class="r">' + fmt(c.total) + ' m²</td></tr>' +
      '<tr><td>Đơn giá ' + esc(g.name) + ' · ' + esc(p.name) + '</td><td class="r">' + fmt(p.min, 2) + ' – ' + fmt(p.max, 2) + ' tr/m²</td></tr>' +
      '<tr><td>Đường vào</td><td class="r">' + (dv.max ? '+' + dv.min + '–' + dv.max + '%' : '0%') + '</td></tr>' +
      (S.mua === 'mua' ? '<tr><td>Khởi công mùa mưa</td><td class="r"><span class="kt-chip">Lưu ý phát sinh</span></td></tr>' : '') +
      (S.goi === 'xayTho' ? '<tr><td colspan="2"><small>Xây thô chưa gồm vật tư hoàn thiện (gạch ốp lát, sơn, thiết bị vệ sinh, cửa…).</small></td></tr>' : ''));
    var mota = 'Từ công cụ khái toán: diện tích quy đổi ' + fmt(c.total) + ' m² (' + (S.w && S.l ? 'lô ' + S.w + '×' + S.l + 'm, ' : '') + $('[data-out="scale"]').textContent + '); móng ' + find(MONG, S.mong).name.toLowerCase() + '; ' + dv.name + '; gói ' + g.name + ' – ' + p.name + '; dự kiến ' + rangeTxt + '.';
    out('ctaLink', '/lien-he?dv=' + encodeURIComponent(g.service) + '&mota=' + encodeURIComponent(mota) + '#lien-he-form', 'href');
    // tabs + bar
    out('tabDt', c.total ? fmt(c.total) + ' m²' : '');
    out('tabCp', c.total ? rangeTxt : '');
    $('#kt-sample').hidden = !S.isSample;
    window.__kt = c;
    save();
  }

  function setTab(t) {
    S.tab = t;
    $('#pane-dt').hidden = t !== 'dt'; $('#pane-cp').hidden = t !== 'cp';
    $('#tab-dt').setAttribute('aria-selected', t === 'dt'); $('#tab-cp').setAttribute('aria-selected', t === 'cp');
    try { history.replaceState(null, '', t === 'cp' ? '#chi-phi' : location.pathname + location.search); } catch (e) {}
    update();
  }
  function renderAll() { renderForm(); renderCost(); update(); }

  /* ====== EVENTS ====== */
  var root = $('#kt');
  function onField(e) {
    var el = e.target, path = el.getAttribute('data-path'); if (!path) return;
    var f = el.getAttribute('data-f');
    var v = el.type === 'checkbox' ? el.checked : el.value;
    if (f) get(path)[f] = v; else setP(path, v);
    S.isSample = false;
    if (el.hasAttribute('data-rerender')) renderAll(); else update();
  }
  root.addEventListener('input', function (e) { if (e.target.tagName === 'INPUT' && e.target.type !== 'radio' && e.target.type !== 'checkbox') onField(e); });
  root.addEventListener('change', function (e) { if (e.target.tagName === 'SELECT' || e.target.type === 'radio' || e.target.type === 'checkbox') onField(e); });
  root.addEventListener('click', function (e) {
    var b = e.target.closest('[data-act]'); if (!b) return;
    var act = b.getAttribute('data-act'), i = +b.getAttribute('data-i');
    if (act === 'tab') { e.preventDefault(); setTab(b.getAttribute('data-tab')); scrollToEl($('#kt-body')); return; }
    if (act === 'mail') { setTab('cp'); scrollToEl($('#kt-mail')); var nm = $('#km-name'); if (nm && !$('#kt-mailform').hidden) nm.focus({ preventScroll: true }); return; }
    if (act === 'print') { printReport(); return; }
    if (act === 'mailagain') { $('#km-done').hidden = true; $('#kt-mailform').hidden = false; $('#km-email').focus(); return; }
    if (act === 'copy') { copy(); return; }
    if (act === 'reset') { var t = S.tab; S = blank(); S.tab = t; renderAll(); var w = $('#kt-w'); if (w) w.focus(); return; }
    S.isSample = false;
    if (act === 'dxr') {
      var x = get(b.getAttribute('data-path'));
      if (x.dxr) { var a = area(x); x.a = a ? String(Math.round(a * 100) / 100).replace('.', ',') : ''; x.dxr = false; }
      else { x.dxr = true; }
    }
    if (act === 'addLau') S.floors.push(lau('lau'));
    if (act === 'addLung') { var idx = 0; S.floors.splice(idx, 0, lau('lung')); }
    if (act === 'dup') S.floors.splice(i + 1, 0, JSON.parse(JSON.stringify(S.floors[i])));
    if (act === 'del') S.floors.splice(i, 1);
    if (act === 'addMai') S.mai.push({ t: 'ton', it: it('') });
    if (act === 'delMai') S.mai.splice(i, 1);
    renderAll();
    if (act === 'dxr') { var nx = $('[data-path="' + b.getAttribute('data-path') + '"]'); if (nx) nx.focus(); }
  });

  function copy() {
    var c = calc(), lines = ['PA1 Construction – Diện tích xây dựng quy đổi', ''];
    var lastG = '';
    c.R.forEach(function (r) { if (!r.a) return; if (r.g !== lastG) { lines.push(r.g.toUpperCase()); lastG = r.g; } lines.push('  ' + r.label + ': ' + fmt(r.a) + ' m² × ' + r.k + '% = ' + fmt(r.q) + ' m²'); });
    lines.push('', 'TỔNG QUY ĐỔI: ' + fmt(c.total) + ' m²', 'phuocan1construction.com/khai-toan');
    var txt = lines.join('\n'), btn = $('[data-act="copy"]');
    function done() { btn.textContent = 'Đã chép'; setTimeout(function () { btn.textContent = 'Sao chép'; }, 1600); }
    function fallback() { var ta = document.createElement('textarea'); ta.value = txt; document.body.appendChild(ta); ta.select(); try { document.execCommand('copy'); done(); } catch (e) {} document.body.removeChild(ta); }
    if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(txt).then(done, fallback); else fallback();
  }

  /* ====== PHIẾU KHÁI TOÁN (PDF A4) — cùng mẫu với analytics/Code.gs ====== */
function pa1Report(d, who, meta) {
  function e(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
  function f(n, k) { k = k == null ? 1 : k; var p = Math.pow(10, k), x = (Math.round(Number(n || 0) * p) / p).toFixed(k).split('.'); x[0] = x[0].replace(/\B(?=(\d{3})+(?!\d))/g, '.'); return x.join(','); }
  var rows = '', last = '';
  (d.rows || []).forEach(function (r) {
    if (r.g !== last) { rows += '<tr class="g"><td colspan="4">' + e(r.g) + '</td></tr>'; last = r.g; }
    rows += '<tr><td>' + e(r.label) + '</td><td class="n">' + f(r.a) + '</td><td class="n">' + e(r.k) + '%</td><td class="n">' + f(r.a * r.k / 100) + '</td></tr>';
  });
  function kv(list) { var h = ''; for (var i = 0; i < list.length; i += 2) { h += '<tr>' + [list[i], list[i + 1]].map(function (x) { return x ? '<td class="l">' + e(x[0]) + '</td><td>' + e(x[1] || '—') + '</td>' : '<td></td><td></td>'; }).join('') + '</tr>'; } return '<table class="kv">' + h + '</table>'; }
  var css = '*{-webkit-print-color-adjust:exact;print-color-adjust:exact}@page{size:A4;margin:11mm 13mm 11mm}' +
