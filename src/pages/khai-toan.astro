  { src: '19_phu-kien-thiet-bi-ve-sinh1.png', label: 'Phụ kiện TBVS' },
  { src: '20_bon-chua-nuoc-va-may-nuoc-nong-nang-luong-mat-troi.png', label: 'Bồn nước & NLMT' },
  { src: '21_chat-lieu-lan-can-cau-thang.png', label: 'Lan can cầu thang' },
  { src: '22_chat-lieu-lan-can-ban-cong.png', label: 'Lan can ban công' },
  { src: '23_vat-tu-chong-tham.png', label: 'Chống thấm' },
