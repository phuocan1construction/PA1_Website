      '<div class="kt-f"><label for="kt-cdt">Tổng diện tích quy đổi</label><div class="kt-unit"><input id="kt-cdt" class="kt-auto" data-out="costArea" readonly tabindex="-1"><i>m²</i></div><span class="kt-hint"><a href="#" data-act="tab" data-tab="dt" style="color:var(--gold-dark);font-weight:700">Sửa ở tab Diện tích</a></span></div>' +
