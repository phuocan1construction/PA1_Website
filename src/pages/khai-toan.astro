  { src: '15_con-ke-be-tong-luoi-chong-nut-va-hoa-chat-chong-moi.png', label: 'Con kê & Chống mối' },
  { src: '18_he-thong-tiep-dia.png', label: 'Hệ thống tiếp địa' },
];

const materialFinishing = [
  { src: '01_gach-op-lat.png', label: 'Gạch ốp lát' },
  { src: '02_keo-dan-gach.png', label: 'Keo dán gạch' },
  { src: '03_keo-cha-ron-gach.png', label: 'Keo chà ron gạch' },
  { src: '04_tran-thach-cao.png', label: 'Trần thạch cao' },
  { src: '05_bot-tret-son-nuoc.png', label: 'Bột trét & Sơn nước' },
  { src: '05_son-lot-chong-kiem.png', label: 'Sơn lót chống kiềm' },
  { src: '06_hang-muc-cua-nhom-kinh.png', label: 'Cửa nhôm kính' },
  { src: '06_hang-muc-cua-nhom-kinh1.png', label: 'Cửa nhôm kính (2)' },
  { src: '07_phu-kien-cua-nhom.png', label: 'Phụ kiện cửa nhôm' },
  { src: '08_khung-bao-ve-cua-so.png', label: 'Khung bảo vệ cửa sổ' },
  { src: '09_hang-muc-cua-noi-that.png', label: 'Cửa nội thất' },
  { src: '09_hang-muc-cua-noi-that1.png', label: 'Cửa nội thất (2)' },
  { src: '09_hang-muc-cua-noi-that2.png', label: 'Cửa nội thất (3)' },
  { src: '10_hang-muc-cua-noi-that.png', label: 'Cửa nội thất (4)' },
  { src: '11_phu-kien-tay-nam-va-khoa-cua.png', label: 'Tay nắm & Khóa cửa' },
  { src: '12_da-granite1.png', label: 'Đá granite' },
  { src: '12_da-nhan-tao.png', label: 'Đá nhân tạo' },
  { src: '12_da-nung-ke.png', label: 'Đá nung kệ' },
  { src: '13_vat-tu-day-mang-day-dien.png', label: 'Dây máng & Dây điện' },
  { src: '14_vo-tu-dien-tong-tu-dien-tang.png', label: 'Vỏ tủ điện tổng & tầng' },
  { src: '15_hang-muc-cong-tac-o-cam-panasonic0.png', label: 'Công tắc Panasonic' },
  { src: '15_hang-muc-cong-tac-o-cam-panasonic1.png', label: 'Công tắc Panasonic (2)' },
  { src: '15_hang-muc-cong-tac-o-cam-schneider.png', label: 'Công tắc Schneider' },
  { src: '15_hang-muc-cong-tac-o-cam-sino.png', label: 'Công tắc Sino' },
  { src: '16_den-led-am-tran1.png', label: 'Đèn LED âm trần' },
  { src: '16_den-trang-tri.png', label: 'Đèn trang trí' },
  { src: '17_thiet-bi-ve-sinh0.png', label: 'Thiết bị vệ sinh' },
  { src: '17_thiet-bi-ve-sinh1.png', label: 'Thiết bị vệ sinh (2)' },
  { src: '17_thiet-bi-ve-sinh2.png', label: 'Thiết bị vệ sinh (3)' },
  { src: '17_guong-soi.png', label: 'Gương soi' },
  { src: '17_pheu-thu-san-va-cau-chan-rac.png', label: 'Phễu thu sàn & Cầu chắn rác' },
  { src: '17_quat-hut-am-tran-wc.png', label: 'Quạt hút âm trần WC' },
