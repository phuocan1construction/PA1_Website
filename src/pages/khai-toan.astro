    h += '<div class="kt-floor"><div class="kt-floor-h"><label class="kt-tog"><input type="checkbox" data-path="thuong.on"' + (S.thuong.on ? ' checked' : '') + ' data-rerender="1"> <b>Tầng thượng</b></label><span class="kt-chip" data-out="fl-thuong"></span></div>' +
