    { id: 'be',    name: 'Móng bè / băng 2 phương', sub: 'Đất yếu, tải lớn',       k: 70 }
  ];
  var HAM = [
    { id: 'lt1',   name: 'Dưới 1,0m (bán hầm)', k: 100 },
