---

<BaseLayout
  title="Tính diện tích & chi phí xây nhà — PA1 Construction"
  description="Công cụ miễn phí: tính diện tích xây dựng quy đổi theo hệ số PA1 (móng, hầm, tầng, ban công, thông tầng, mái) và ước tính chi phí xây thô / trọn gói."
  activePage="bao-gia"
>
<div class="kt" id="kt">
  <div class="kt-freeze" id="kt-freeze">
  <section class="kt-head">
    <div class="wrap">
      <div class="kt-eyebrow">PA1 Construction · Công cụ miễn phí</div>
      <h1>Tính diện tích &amp; chi phí xây nhà</h1>
      <p>Nhập kích thước từng tầng. Hệ thống tự áp hệ số quy đổi theo cách tính của PA1, ra tổng m² và khoảng chi phí theo gói thi công.</p>
    </div>
  </section>
  <div class="kt-tabbar"><div class="wrap kt-tabbar-in">
    <div class="kt-tabs" role="tablist">
      <button type="button" role="tab" id="tab-dt" aria-selected="true" data-act="tab" data-tab="dt">Diện tích <small data-out="tabDt"></small></button>
      <button type="button" role="tab" id="tab-cp" aria-selected="false" data-act="tab" data-tab="cp">Chi phí <small data-out="tabCp"></small></button>
    </div>
    <button type="button" class="kt-mailbtn" data-act="mail">Nhận khái toán PDF qua email →</button>
  </div></div>
  </div>

  <div class="wrap kt-body" id="kt-body">

    <div class="kt-sample" id="kt-sample" hidden>
      <span>Đang hiển thị <b>ví dụ</b>: nhà phố 5×20m, 1 trệt 2 lầu, sân thượng.</span>
      <button type="button" data-act="reset">Nhập nhà của bạn</button>
    </div>

    <!-- TAB DIỆN TÍCH -->
    <div id="pane-dt" role="tabpanel" aria-labelledby="tab-dt">
      <nav class="kt-steps" aria-label="Các bước">
        <a href="#kt-s1"><span>1</span>Lô đất &amp; đường vào</a>
        <a href="#kt-s2"><span>2</span>Móng &amp; hầm</a>
        <a href="#kt-s3"><span>3</span>Các tầng</a>
        <a href="#kt-s4"><span>4</span>Mái</a>
        <a href="#kt-kq"><span>5</span>Kết quả</a>
      </nav>
      <div class="kt-grid">
        <div class="kt-form" id="kt-form"></div>
        <aside class="kt-result" id="kt-kq">
          <div class="kt-total">
            <div class="kt-eyebrow">Tổng diện tích xây dựng quy đổi</div>
            <div class="kt-big"><span data-out="total">0</span><small>m²</small></div>
            <p>Lấy con số này nhân đơn giá/m² để ra chi phí.</p>
            <div class="kt-mini">
              <div>Sàn thực<b data-out="floorReal">0 m²</b></div>
              <div>Quy mô<b data-out="scale">–</b></div>
              <div>Mật độ XD<b data-out="density">–</b></div>
            </div>
          </div>
          <div class="kt-card">
            <div class="kt-card-h"><h3>Bảng chi tiết</h3><button type="button" class="kt-ib" data-act="copy">Sao chép</button></div>
            <div class="kt-tbl"><table>
              <thead><tr><th>Hạng mục</th><th class="r">m²</th><th class="r">HS</th><th class="r">Quy đổi</th></tr></thead>
              <tbody data-out="rows"></tbody>
              <tfoot><tr><td colspan="3">Tổng quy đổi</td><td class="r" data-out="total2">0</td></tr></tfoot>
            </table></div>
          </div>
          <div class="kt-card" data-out="factorsCard">
            <h3>Yếu tố ảnh hưởng đơn giá</h3>
            <div class="kt-factors" data-out="factors"></div>
          </div>
          <div class="kt-cta">
            <button type="button" class="kt-btn" data-act="tab" data-tab="cp">Ước tính chi phí →</button>
          </div>
        </aside>
      </div>

      <details class="kt-how">
        <summary>Cách PA1 tính diện tích xây dựng (hình minh hoạ)</summary>
        <div class="kt-how-body">
          <img src={asset('/assets/images/quotation/1_General/001_CachTinhDienTichXayDung.png')} alt="Mặt cắt nhà phố thể hiện hệ số quy đổi diện tích: móng, hầm, trệt, lầu, ban công, thông tầng, sân thượng, mái" loading="lazy">
          <div class="kt-tbl"><table class="kt-legend">
            <tr class="g"><td colspan="2">Móng (tính trên diện tích trệt)</td></tr>
            <tr><td>Móng cọc</td><td>30%</td></tr><tr><td>Móng đơn</td><td>40%</td></tr><tr><td>Móng băng 1 phương</td><td>50%</td></tr><tr><td>Móng bè / băng 2 phương</td><td>70%</td></tr>
            <tr class="g"><td colspan="2">Hầm (theo độ sâu so với vỉa hè)</td></tr>
            <tr><td>Dưới 1,0m (bán hầm)</td><td>100%</td></tr><tr><td>1,0 – 1,5m</td><td>150%</td></tr><tr><td>1,5 – 1,7m</td><td>170%</td></tr><tr><td>1,7 – 2,0m</td><td>200%</td></tr><tr><td>Trên 2,0m</td><td>250%</td></tr>
            <tr class="g"><td colspan="2">Sàn</td></tr>
            <tr><td>Sàn trong nhà có mái</td><td>100%</td></tr><tr><td>Sân trệt không mái / mái tole</td><td>70%</td></tr><tr><td>Sân trệt mái BTCT</td><td>100%</td></tr>
            <tr><td>Ô thông tầng ≤ 8m²</td><td>100%</td></tr><tr><td>Ô thông tầng &gt; 8m²</td><td>50%</td></tr><tr><td>Ban công</td><td>50%</td></tr><tr><td>Sân thượng không mái</td><td>50%</td></tr>
            <tr class="g"><td colspan="2">Mái</td></tr>
            <tr><td>Mái tôn</td><td>30%</td></tr><tr><td>Mái BTCT</td><td>50%</td></tr><tr><td>Mái có hệ đà BTCT</td><td>70%</td></tr><tr><td>Mái BTCT lợp ngói</td><td>100%</td></tr>
          </table></div>
        </div>
      </details>
    </div>

    <!-- TAB CHI PHÍ -->
    <div id="pane-cp" role="tabpanel" aria-labelledby="tab-cp" hidden>
      <div class="kt-grid">
        <div class="kt-form" id="kt-cost"></div>
        <aside class="kt-result">
          <div class="kt-total">
            <div class="kt-eyebrow">Chi phí dự kiến</div>
            <div class="kt-big kt-range" data-out="range">–</div>
            <p data-out="rangeNote"></p>
          </div>
          <div class="kt-card">
            <h3>Cách tính</h3>
            <div class="kt-tbl"><table><tbody data-out="costRows"></tbody></table></div>
          </div>
          <div class="kt-cta">
            <a class="kt-btn" data-out="ctaLink" href="/lien-he">Nhận báo giá chi tiết từ PA1 →</a>
            <button type="button" class="kt-btn sec" data-act="tab" data-tab="dt">← Sửa diện tích</button>
          </div>
          <p class="kt-fine">Giá tham khảo theo bảng giá PA1 hiện hành, chưa gồm thiết kế, xin phép, điện nước kéo ngoài. PA1 khảo sát thực tế để báo giá chính xác.</p>
          <div class="kt-card kt-mail" id="kt-mail">
            <h3>Nhận khái toán PDF qua email</h3>
            <p class="kt-fine">Phiếu A4 gồm bảng diện tích quy đổi và chi phí dự kiến, gửi ngay vào hộp thư của anh/chị.</p>
            <form id="kt-mailform" novalidate>
              <div class="kt-f"><label for="km-name">Họ tên *</label><input id="km-name" autocomplete="name" placeholder="Nguyễn Văn A"></div>
              <div class="kt-f"><label for="km-phone">Số điện thoại</label><input id="km-phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="09xx xxx xxx"></div>
              <div class="kt-f"><label for="km-email">Email nhận file *</label><input id="km-email" type="email" inputmode="email" autocomplete="email" placeholder="ban@email.com"></div>
              <p class="kt-msg" id="km-msg" role="status" hidden></p>
              <button type="submit" class="kt-btn" id="km-send">Gửi khái toán về email</button>
              <p class="kt-fine">Thông tin chỉ dùng để PA1 gửi khái toán và tư vấn cho anh/chị.</p>
            </form>
            <div id="km-done" hidden>
              <p class="kt-msg ok" id="km-ok"></p>
              <button type="button" class="kt-btn sec" data-act="print">Tải / in PDF ngay</button>
              <button type="button" class="kt-ib" data-act="mailagain" style="align-self:flex-start">Gửi tới email khác</button>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </div>

  <!-- Vật tư (chuyển từ trang Báo giá) -->
  <section class="kt-mat" style="background: var(--light);">
    <div class="wrap">
      <div class="quote-category">
        <div class="section-header">
          <h2>Vật tư phần thô</h2>
          <p>Thép, xi măng, gạch, bê tông, ống nước, dây điện — các hạng mục kết cấu chính.</p>
        </div>
        <div class="quote-grid">
          {materialStructural.map(item => (
            <div class="quote-card">
              <img src={asset(`${basePath}/1_General/1_Material_Structural/${item.src}`)} alt={item.label} loading="lazy">
              <div class="quote-label">{item.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="kt-mat">
    <div class="wrap">
      <div class="quote-category">
        <div class="section-header">
          <h2>Vật tư hoàn thiện</h2>
          <p>Gạch ốp lát, sơn, cửa, thiết bị vệ sinh, đèn, lan can — hoàn thiện công trình.</p>
        </div>
        <div class="quote-grid">
          {materialFinishing.map(item => (
            <div class="quote-card">
              <img src={asset(`${basePath}/1_General/2_Material_Finishing/${item.src}`)} alt={item.label} loading="lazy">
              <div class="quote-label">{item.label}</div>
            </div>
          ))}
        </div>
        <p style="text-align:center;margin-top:var(--sp-4)"><a href="/bao-gia" class="btn btn-secondary">Xem bảng báo giá Thiết kế &amp; Thi công →</a></p>
      </div>
    </div>
  </section>

  <CtaBand
    title="Cần báo giá chi tiết cho công trình của bạn?"
    description="Liên hệ PA1 để được khảo sát thực tế & báo giá chính xác trong 24 giờ."
    buttonText="Liên hệ báo giá →"
  />
  <noscript><div class="wrap"><p>Công cụ cần bật JavaScript để tính toán.</p></div></noscript>
</div>

<style is:global>
.kt{--kt-line:#e6dfcf;--kt-soft:#fbf3dc;--kt-bg:#faf8f3;--kt-warn:#b4541f;--kt-warn-soft:#fbe9dc;background:var(--kt-bg)}
.kt-freeze{position:sticky;top:70px;z-index:80}
.kt-freeze.stuck section.kt-head{padding:10px 0}
.kt-freeze.stuck .kt-head .kt-eyebrow,.kt-freeze.stuck .kt-head p{display:none}
.kt-freeze.stuck .kt-head h1{font-size:22px}
.kt-tabbar{background:var(--kt-bg);border-bottom:1px solid var(--kt-line);box-shadow:0 8px 14px -12px rgba(0,0,0,.35)}
.kt-tabbar-in{display:flex;align-items:center;justify-content:space-between;gap:12px}
.kt-mailbtn{font-weight:700;font-size:14px;background:var(--gold);color:var(--dark);border-radius:8px;padding:9px 16px;white-space:nowrap}
.kt-mailbtn:hover{background:var(--gold-dark)}
@media (max-width:760px){.kt-mailbtn{display:none}.kt-freeze.stuck .kt-head h1{font-size:18px}}
.kt-msg{margin:0;font-size:13px;color:var(--kt-warn);font-weight:700}.kt-msg.ok{color:#2f7d32}
.kt-mail form,#km-done{display:flex;flex-direction:column;gap:10px}
.kt-btn[disabled]{opacity:.6;cursor:wait}
.kt [hidden]{display:none!important}
.kt .wrap{padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.kt section.kt-head{padding:40px 0 24px;background:var(--dark);color:var(--white)}
.kt-head h1{color:var(--white);text-wrap:balance}
.kt-head p{color:#cfcac0;max-width:62ch;margin:10px 0 0}
.kt-eyebrow{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--gold);font-weight:700;margin-bottom:6px}
.kt-body{padding-top:16px;padding-bottom:40px}
.kt-tabs{display:flex;gap:4px;overflow-x:auto;min-width:0}
.kt-tabs button{font-family:var(--font-display);font-size:20px;font-weight:700;color:var(--text-light);background:transparent;border-bottom:3px solid transparent;padding:10px 18px;margin-bottom:-1px;white-space:nowrap}
.kt-tabs button[aria-selected="true"]{color:var(--dark);border-bottom-color:var(--gold)}
.kt-tabs small{font-family:var(--font-body);font-size:13px;font-weight:700;color:var(--gold-dark);margin-left:6px;font-variant-numeric:tabular-nums}
.kt-sample{display:flex;flex-wrap:wrap;gap:8px 14px;align-items:center;justify-content:space-between;background:var(--kt-soft);border:1px solid var(--gold);border-radius:8px;padding:10px 14px;font-size:14px;margin-bottom:16px}
.kt-sample button{font-weight:700;background:var(--dark);color:var(--white);border-radius:6px;padding:6px 12px}
.kt-steps{display:flex;gap:6px;overflow-x:auto;margin-bottom:16px;padding-bottom:2px}
.kt-steps a{flex:0 0 auto;color:var(--text-light);font-size:13px;font-weight:700;border:1px solid var(--kt-line);background:var(--white);border-radius:999px;padding:6px 14px}
.kt-steps a:hover{border-color:var(--gold);color:var(--dark)}
.kt-steps span{color:var(--gold-dark);margin-right:6px}
.kt-grid{display:grid;grid-template-columns:minmax(0,1fr) 380px;gap:20px;align-items:start}
@media (max-width:960px){.kt-grid{grid-template-columns:minmax(0,1fr)}}
.kt-form{display:flex;flex-direction:column;gap:16px;min-width:0}
.kt-card{background:var(--white);border:1px solid var(--kt-line);border-radius:10px;padding:18px;display:flex;flex-direction:column;gap:14px;scroll-margin-top:calc(var(--kt-top,150px) + 12px)}
.kt-card h2{font-size:21px}.kt-card h3{font-size:17px}
.kt-card-h{display:flex;gap:10px;align-items:baseline;justify-content:space-between;flex-wrap:wrap}
.kt-stepno{font-size:12px;font-weight:700;color:var(--gold-dark);letter-spacing:.1em}
.kt-sub{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--text-light);margin:0}
.kt-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px}
.kt-f{display:flex;flex-direction:column;gap:4px;min-width:0}
.kt-f>label{font-size:13px;font-weight:700;color:var(--dark)}
.kt-hint{font-size:12px;color:var(--text-light)}
.kt input:not([type=radio]):not([type=checkbox]),.kt select{font-size:15px;color:var(--dark);background:var(--kt-bg);border:1px solid var(--kt-line);border-radius:8px;padding:9px 10px;width:100%;min-width:0}
.kt input:focus,.kt select:focus,.kt button:focus-visible,.kt a:focus-visible{outline:2px solid var(--gold);outline-offset:1px}
.kt-unit{position:relative}.kt-unit input{padding-right:40px!important}.kt-unit i{position:absolute;right:10px;top:50%;transform:translateY(-50%);font-style:normal;color:var(--text-light);font-size:13px}
.kt-auto{background:var(--kt-soft)!important;border-color:transparent!important;font-weight:700}
.kt-chip{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:700;border-radius:999px;padding:3px 10px;background:var(--kt-soft);color:var(--dark);width:fit-content}
.kt-chip.warn{background:var(--kt-warn-soft);color:var(--kt-warn)}
.kt-seg{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:8px}
.kt-seg label{position:relative;border:1px solid var(--kt-line);border-radius:8px;padding:10px;cursor:pointer;display:flex;flex-direction:column;gap:2px;background:var(--kt-bg)}
.kt-seg input{position:absolute;opacity:0;width:1px;height:1px}
.kt-seg label:has(input:checked){border-color:var(--gold);background:var(--kt-soft);box-shadow:inset 0 0 0 1px var(--gold)}
.kt-seg label:has(input:focus-visible){outline:2px solid var(--gold)}
.kt-seg b{font-size:14px;color:var(--dark)}.kt-seg small{color:var(--text-light);font-size:12px}
.kt-seg .k{font-size:18px;font-weight:700;color:var(--gold-dark)}
.kt-tog{display:flex;align-items:center;gap:10px;font-weight:700;cursor:pointer;color:var(--dark);width:fit-content}
.kt-tog input{appearance:none;-webkit-appearance:none;width:40px;height:22px;border-radius:999px;background:var(--kt-line);position:relative;cursor:pointer;margin:0;flex:0 0 auto}
.kt-tog input::after{content:"";position:absolute;top:3px;left:3px;width:16px;height:16px;border-radius:50%;background:var(--white);transition:left .15s}
.kt-tog input:checked{background:var(--gold)}.kt-tog input:checked::after{left:21px}
.kt-off{opacity:.45;pointer-events:none}
.kt-floor{border:1px solid var(--kt-line);border-radius:8px;overflow:hidden}
.kt-floor-h{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:8px 12px;background:var(--kt-bg);border-bottom:1px solid var(--kt-line);flex-wrap:wrap}
.kt-floor-h b{font-family:var(--font-display);font-size:17px;color:var(--dark)}
.kt-floor-h .tools{display:flex;gap:6px;align-items:center}
.kt-ib{font-size:12px;border:1px solid var(--kt-line);background:var(--white);color:var(--text-light);border-radius:6px;padding:4px 9px}
.kt-ib:hover{border-color:var(--gold);color:var(--dark)}
.kt-it{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,170px) 50px 76px;gap:10px;align-items:center;padding:9px 12px;border-bottom:1px solid var(--kt-line)}
.kt-it:last-child{border-bottom:0}
.kt-nm{font-size:14px;color:var(--dark);display:flex;flex-direction:column;gap:3px;min-width:0}
.kt-nm small{color:var(--text-light);font-size:12px}
.kt-nm select{padding:5px 8px!important;font-size:13px!important;width:auto!important}
.kt-inp{display:flex;gap:4px;align-items:center;min-width:0}
.kt-inp input{padding:7px 8px!important;text-align:right}
.kt-x{color:var(--text-light);font-size:12px}
.kt-dxr{font-size:11px;font-weight:700;border:1px solid var(--kt-line);background:var(--white);color:var(--text-light);border-radius:6px;padding:5px 6px;flex:0 0 auto}
.kt-dxr.on{background:var(--kt-soft);border-color:var(--gold);color:var(--dark)}
.kt-k{font-weight:700;color:var(--gold-dark);text-align:right;font-variant-numeric:tabular-nums}
.kt-q{text-align:right;font-weight:700;font-variant-numeric:tabular-nums;color:var(--dark)}
@media (max-width:560px){.kt-it{grid-template-columns:minmax(0,1fr) minmax(0,150px)}.kt-k{grid-column:1;text-align:left}.kt-q{grid-column:2}}
.kt-add{display:flex;gap:8px;flex-wrap:wrap}
.kt-btn-o{font-weight:700;font-size:13px;color:var(--gold-dark);background:transparent;border:1px dashed var(--gold);border-radius:8px;padding:8px 14px}
.kt-btn-o:hover{background:var(--kt-soft)}
.kt-result{position:sticky;top:calc(var(--kt-top,150px) + 12px);display:flex;flex-direction:column;gap:14px;min-width:0}
.kt-total{background:var(--dark);color:var(--white);border-radius:10px;padding:18px}
.kt-big{font-family:var(--font-display);font-size:44px;line-height:1.1;color:var(--gold);font-variant-numeric:tabular-nums}
.kt-big small{font-size:18px;color:var(--white);opacity:.85;margin-left:6px}
.kt-range{font-size:34px}
.kt-total p{margin:6px 0 0;font-size:13px;color:#cfcac0}
.kt-mini{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:12px}
.kt-mini div{border-top:1px solid #444;padding-top:6px;font-size:12px;color:#cfcac0}
.kt-mini b{display:block;font-size:15px;color:var(--white);font-variant-numeric:tabular-nums}
.kt-tbl{overflow-x:auto}
.kt table{width:100%;border-collapse:collapse;font-size:13px;font-variant-numeric:tabular-nums}
.kt th{text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--text-light);font-weight:700;padding:6px 4px;border-bottom:1px solid var(--kt-line)}
.kt td{padding:7px 4px;border-bottom:1px solid var(--kt-line);color:var(--dark)}
.kt td.r,.kt th.r{text-align:right}
.kt tr.g td{font-weight:700;padding-top:10px;border-bottom:0;color:var(--gold-dark);font-size:12px;text-transform:uppercase;letter-spacing:.06em}
.kt tfoot td{font-weight:700;font-size:15px;border-bottom:0;padding-top:10px}
.kt td small{display:block;color:var(--text-light);font-size:11px}
.kt-empty{color:var(--text-light);font-size:13px;padding:10px 4px}
.kt-legend td:last-child{text-align:right;font-weight:700;color:var(--gold-dark)}
.kt-factors{display:flex;flex-direction:column;gap:8px;font-size:13px}
.kt-factors div{display:flex;justify-content:space-between;gap:10px;align-items:center}
.kt-cta{display:flex;flex-direction:column;gap:8px}
.kt-btn{display:block;text-align:center;font-size:15px;font-weight:700;border-radius:8px;padding:12px;background:var(--gold);color:var(--dark)}
.kt-btn:hover{background:var(--gold-dark)}
.kt-btn.sec{background:transparent;border:1px solid var(--dark)}
.kt-btn.sec:hover{background:var(--white)}
.kt-fine{font-size:12px;color:var(--text-light);margin:0}
.kt-how{background:var(--white);border:1px solid var(--kt-line);border-radius:10px;padding:14px 18px;margin-top:20px}
.kt-how summary{cursor:pointer;font-weight:700;color:var(--dark)}
.kt-how-body{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:20px;margin-top:14px;align-items:start}
@media (max-width:760px){.kt-how-body{grid-template-columns:minmax(0,1fr)}}
.kt-how-body img{border-radius:8px;border:1px solid var(--kt-line)}
@media (max-width:960px){
  .kt-result{position:static}
}
@media (prefers-reduced-motion:reduce){.kt *{transition:none!important}}
</style>

<script is:inline>
(function () {
  /* ====== BẢNG GIÁ & HỆ SỐ PA1 — sửa số ở đây ====== */
