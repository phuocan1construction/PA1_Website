    'h1{font-size:14pt;text-align:center;margin:8px 0 2px;letter-spacing:.5px}.sub{text-align:center;color:#666;font-size:9pt;margin:0 0 10px}' +
    'h2{font-size:9.5pt;background:#1a1a1a;color:#fff;padding:3px 8px;margin:8px 0 3px}' +
    'table{width:100%;border-collapse:collapse}.kv td{padding:2px 6px;border-bottom:1px solid #e5e0d4;vertical-align:top}.kv td.l{width:17%;color:#666;white-space:nowrap}' +
    '.t th{background:#f4ead3;text-align:left;font-size:8.5pt;padding:4px 6px;border-bottom:1px solid #d9c9a0}.t th.n{text-align:right}' +
    '.t td{padding:2px 6px;border-bottom:1px solid #eee}.t .n{text-align:right;white-space:nowrap}' +
    '.t tr.g td{font-weight:bold;color:#8a6a10;background:#fbf7ec;font-size:8pt;text-transform:uppercase;letter-spacing:.5px}' +
    '.t tr.tot td{font-weight:bold;font-size:11.5pt;border-top:2px solid #1a1a1a;border-bottom:0;padding-top:6px}' +
    '.big{border:2px solid #F2B529;background:#fffaf0;padding:5px;text-align:center;margin-top:8px}.big .k{font-size:9pt;color:#666;text-transform:uppercase;letter-spacing:1px}.big .v{font-size:18pt;font-weight:bold;margin-top:2px}' +
    '.note{font-size:8pt;color:#555;margin-top:8px}.note ul{margin:4px 0 0 16px;padding:0}' +
    '.call{text-align:center;font-size:10pt;margin-top:6px}.call b{font-size:12pt}' +
    '.ft{width:100%;border-collapse:collapse;margin-top:10px;background:#1a1a1a;color:#e8e8e8;font-size:8pt;line-height:1.5}.ft td{padding:7px 10px;vertical-align:top}' +
    '.ft b{color:#F2B529}.ft .r{text-align:right}';
  return '<!DOCTYPE html><html lang="vi"><head><meta charset="utf-8"><title>Khái toán ' + e(meta.id) + '</title><style>' + css + '</style></head><body>' +
    '<table class="hd"><tr><td><div class="brand">PHƯỚC AN 1 CONSTRUCTION</div><div class="slogan">Dự án chất, PA1 lo tất</div></td>' +
    '<td class="ct">Hotline: 0523.023.023<br>Phuocan1construction@gmail.com<br>phuocan1construction.com</td></tr></table>' +
    '<h1>PHIẾU KHÁI TOÁN DIỆN TÍCH &amp; CHI PHÍ XÂY DỰNG</h1>' +
    '<p class="sub">Mã phiếu: <b>' + e(meta.id) + '</b> &nbsp;·&nbsp; Ngày lập: ' + e(meta.date) + '</p>' +
    '<h2>1. Khách hàng &amp; công trình</h2>' +
    kv([['Khách hàng', who.name], ['Điện thoại', who.phone], ['Email', who.email], ['Lô đất', d.lot], ['Quy mô', d.scale], ['Móng', d.mong], ['Lộ giới trước nhà', d.logioi], ['Đường vào', d.duong], ['Dự kiến khởi công', d.mua]]) +
    '<h2>2. Diện tích xây dựng quy đổi</h2>' +
    '<table class="t"><thead><tr><th>Hạng mục</th><th class="n">Diện tích (m²)</th><th class="n">Hệ số</th><th class="n">Quy đổi (m²)</th></tr></thead><tbody>' + rows +
    '<tr class="tot"><td colspan="3">TỔNG DIỆN TÍCH QUY ĐỔI</td><td class="n">' + f(d.total) + '</td></tr></tbody></table>' +
    '<h2>3. Chi phí dự kiến</h2>' +
    kv([['Gói thi công', d.goi + ' · ' + d.pkg], ['Đơn giá', d.price], ['Phát sinh đường vào', d.hem], ['Diện tích tính giá', f(d.total) + ' m²']]) +
    '<div class="big"><div class="k">Chi phí dự kiến</div><div class="v">' + e(d.range) + '</div></div>' +
    '<p class="call">Khảo sát &amp; báo giá chi tiết miễn phí — gọi <b>0523.023.023</b></p>' +
    '<div class="note"><b>Ghi chú</b><ul>' +
    '<li>Khái toán mang tính tham khảo, theo bảng giá PA1 hiện hành và số liệu khách hàng tự nhập.</li>' +
    (d.xayTho ? '<li>Gói Xây thô chưa gồm vật tư hoàn thiện (gạch ốp lát, sơn, thiết bị vệ sinh, cửa…).</li>' : '') +
    '<li>Chưa gồm chi phí thiết kế, xin phép xây dựng, điện nước kéo từ ngoài vào, nội thất rời.</li>' +
    '</ul></div>' +
    '<table class="ft"><tr><td><b>PA1 CONSTRUCTION</b><br>Người đại diện: Nguyễn Hữu Phước<br>W: Thứ 2 – Thứ 7, 8h00 – 17h00</td>' +
    '<td>T: <b>0523.023.023</b><br>E: Phuocan1construction@gmail.com<br>phuocan1construction.com</td>' +
    '<td>A1: 243/15A Bình Thung, Đông Hòa, TP. Hồ Chí Minh<br>A2: Phước Hậu, Vĩnh Long (Tươi: 0354.020.916)</td></tr></table>' +
    '</body></html>';
}

  function rangeOf(lo, hi) { return (lo || hi) ? (moneyUnit(lo) === moneyUnit(hi) ? money(lo) + ' – ' + money(hi) + ' ' + moneyUnit(hi) : money(lo) + ' ' + moneyUnit(lo) + ' – ' + money(hi) + ' ' + moneyUnit(hi)) : '–'; }
  function snapshot() {
    var c = calc(), dv = find(DUONG, S.dv), g = PRICES[S.goi], p = find(g.list, S.pkg[S.goi]);
    var lo = c.total * p.min * (1 + dv.min / 100), hi = c.total * p.max * (1 + dv.max / 100);
    return {
      lot: c.lot ? S.w + ' × ' + S.l + ' m (' + fmt(c.lot) + ' m²)' : '',
      scale: $('[data-out="scale"]').textContent, mong: find(MONG, S.mong).name, logioi: find(LOGIOI, S.lg).name,
      duong: dv.name, hem: dv.max ? '+' + dv.min + '–' + dv.max + '% đơn giá' : 'Không phát sinh', mua: find(MUA, S.mua).name,
      rows: c.R.filter(function (r) { return r.a; }).map(function (r) { return { g: r.g, label: r.label + (r.note ? ' (' + r.note + ')' : ''), a: Math.round(r.a * 100) / 100, k: r.k }; }),
      total: Math.round(c.total * 10) / 10, goi: g.name, pkg: p.name, price: fmt(p.min, 2) + ' – ' + fmt(p.max, 2) + ' triệu đ/m²',
      range: rangeOf(lo, hi), xayTho: S.goi === 'xayTho'
    };
  }
  var lastSend = null;
  function nowVN() { var d = new Date(), z = function (n) { return (n < 10 ? '0' : '') + n; }; return z(d.getDate()) + '/' + z(d.getMonth() + 1) + '/' + d.getFullYear() + ' ' + z(d.getHours()) + ':' + z(d.getMinutes()); }
  function localId() { var d = new Date(), z = function (n) { return (n < 10 ? '0' : '') + n; }; return 'KT-' + String(d.getFullYear()).slice(2) + z(d.getMonth() + 1) + z(d.getDate()) + '-' + Math.random().toString(36).slice(2, 6).toUpperCase(); }
  function printReport() {
    var who = lastSend || { name: ($('#km-name') || {}).value || '', phone: ($('#km-phone') || {}).value || '', email: ($('#km-email') || {}).value || '' };
    var html = pa1Report(snapshot(), who, { id: (lastSend && lastSend.id) || localId(), date: nowVN() });
    var fr = document.createElement('iframe');
    fr.setAttribute('aria-hidden', 'true'); fr.style.cssText = 'position:fixed;right:0;bottom:0;width:0;height:0;border:0';
    document.body.appendChild(fr);
    var doc = fr.contentWindow.document; doc.open(); doc.write(html); doc.close();
    setTimeout(function () { try { fr.contentWindow.focus(); fr.contentWindow.print(); } catch (e) {} setTimeout(function () { fr.remove(); }, 60000); }, 300);
  }
  var EP = 'https://script.google.com/macros/s/AKfycbxvPQYoPNod0InObA73rEhFyoWnXXRjNYJsNzT9hjGVZrc5HOUaGC5DkZ_gJxxDpqvOGQ/exec';
  function vid() {
    if (window.PA1_VID) return window.PA1_VID;
    var v = null; try { v = localStorage.getItem('pa1_vid'); } catch (e) {}
    if (!/^V-[A-Z0-9]{6}$/.test(v || '')) { v = 'V-'; for (var i = 0; i < 6; i++) v += 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'[Math.floor(Math.random() * 32)]; try { localStorage.setItem('pa1_vid', v); } catch (e) {} }
    return v;
  }
  try { var saved = JSON.parse(localStorage.getItem('pa1_kt_contact') || 'null'); if (saved) { ['name', 'phone', 'email'].forEach(function (k) { var el = $('#km-' + k); if (el && saved[k]) el.value = saved[k]; }); } } catch (e) {}
  $('#kt-mailform').addEventListener('submit', function (e) {
    e.preventDefault();
    var name = $('#km-name').value.trim(), phone = $('#km-phone').value.trim(), email = $('#km-email').value.trim(), msg = $('#km-msg'), btn = $('#km-send');
    function show(t) { msg.textContent = t; msg.hidden = !t; }
    if (!name) { show('Vui lòng nhập họ tên.'); $('#km-name').focus(); return; }
    if (!/^[^\s@<>"']+@[^\s@<>"']+\.[a-z]{2,}$/i.test(email)) { show('Email chưa đúng định dạng, ví dụ: ten@gmail.com'); $('#km-email').focus(); return; }
    if (!calc().total) { show('Chưa có diện tích. Nhập số liệu ở tab Diện tích trước.'); return; }
    show(''); btn.disabled = true; btn.textContent = 'Đang gửi…';
    try { localStorage.setItem('pa1_kt_contact', JSON.stringify({ name: name, phone: phone, email: email })); } catch (er) {}
    var data = snapshot(), v = vid();
    function post(o) { return fetch(window.PA1_TRACK_ENDPOINT || EP, { method: 'POST', headers: { 'Content-Type': 'text/plain;charset=utf-8' }, body: JSON.stringify(o) }).then(function (r) { return r.json(); }); }
    function finish(ok, id) {
      btn.disabled = false; btn.textContent = 'Gửi khái toán về email';
      lastSend = { name: name, phone: phone, email: email, id: id || localId() };
      $('#kt-mailform').hidden = true; $('#km-done').hidden = false;
      $('#km-ok').textContent = ok
        ? 'Đã gửi phiếu ' + lastSend.id + ' tới ' + email + '. Nếu chưa thấy, anh/chị kiểm tra thêm mục Spam / Quảng cáo.'
        : 'PA1 đã nhận thông tin và sẽ gửi khái toán tới ' + email + ' sớm nhất. Anh/chị có thể tải PDF ngay bên dưới.';
      $('#km-ok').classList.toggle('ok', true);
    }
    post({ t: 'khaitoan', vid: v, path: '/khai-toan', name: name, phone: phone, email: email, data: data })
      .then(function (r) {
        if (r && r.ok) return finish(true, r.id);
        if (r && r.error === 'email') { btn.disabled = false; btn.textContent = 'Gửi khái toán về email'; return show('Email chưa đúng định dạng.'); }
        if (r && r.error === 'limit') { btn.disabled = false; btn.textContent = 'Gửi khái toán về email'; return show('Email này đã nhận nhiều khái toán trong hôm nay. Anh/chị tải PDF hoặc gọi 0523.023.023.'); }
        // máy chủ chưa hỗ trợ gửi mail → vẫn lưu thông tin khách
        return post({ t: 'lead', vid: v, path: '/khai-toan', name: name, phone: phone, email: email, service: 'Khái toán ' + data.total + ' m² · ' + data.range }).then(function () { finish(false); }, function () { finish(false); });
      }, function () { finish(false); });
  });

  /* ====== FREEZE ====== */
  var fz = $('#kt-freeze'), hdr = document.querySelector('.site-header'), stuck = false;
  function ktTop() { return parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--kt-top')) || 150; }
  function measure() { var h = hdr ? hdr.offsetHeight : 70; fz.style.top = h + 'px'; document.documentElement.style.setProperty('--kt-top', (h + fz.offsetHeight) + 'px'); }
  function setStuck(v) { if (v === stuck) return; stuck = v; fz.classList.toggle('stuck', v); measure(); }
  function onScroll() { var y = window.scrollY; setStuck(stuck ? y > 20 : y > 90); }
  function scrollToEl(el) { if (!el) return; setStuck(true); var top = el.getBoundingClientRect().top + window.scrollY - ktTop() - 10; window.scrollTo(0, Math.max(0, top)); if (top <= 20) setStuck(false); }
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', measure);

  renderAll();
  setTab(S.tab || 'dt');
  measure(); onScroll();
})();
</script>
</BaseLayout>
